note\" style=\"opacity:0;\">Billed annually — save $60/user/yr</p>\n        </div>\n        <hr>\n        <ul style=\"list-style:none;padding:0;margin:0 0 1.25rem;display:flex;flex-direction:column;gap:0.5rem;\">\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> Everything in Pro</li>\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> Unlimited team members</li>\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> 500 GB storage</li>\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> SSO (SAML) &amp; SCIM provisioning</li>\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> Audit logs &amp; data residency</li>\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> Full API access (10 k req/min)</li>\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> Dedicated account manager</li>\n          <li class=\"row gap-sm\"><span style=\"color:var(--accent,#5b6abf);\">✓</span> Custom SLA (99.95 % uptime)</li>\n        </ul>\n        <button class=\"btn btn-secondary btn-block\">Contact Sales</button>\n        <p class=\"small muted center\" style=\"margin-top:0.5rem;\">Volume discounts for 50+ seats</p>\n      </div>\n    </div>\n\n    <!-- All plans include -->\n    <div class=\"card\">\n      <div class=\"card-title\">Every plan includes</div>\n      <div class=\"grid cols-4\" style=\"margin-top:0.75rem;\">\n        <div class=\"stack gap-sm\">\n          <span class=\"badge badge-outline\">99.9% Uptime</span>\n          <span class=\"small muted\">Guaranteed via our SLA</span>\n        </div>\n        <div class=\"stack gap-sm\">\n          <span class=\"badge badge-outline\">AES-256 Encryption</span>\n          <span class=\"small muted\">Data at rest &amp; in transit</span>\n        </div>\n        <div class=\"stack gap-sm\">\n          <span class=\"badge badge-outline\">GDPR &amp; SOC 2</span>\n          <span class=\"small muted\">Compliance out of the box</span>\n        </div>\n        <div class=\"stack gap-sm\">\n          <span class=\"badge badge-outline\">Unlimited Environments</span>\n          <span class=\"small muted\">Staging, dev &amp; preview</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Edge-case / FAQ hint -->\n    <div class=\"alert\" style=\"margin-bottom:1rem;\">\n      <strong>Need something different?</strong>\n      <span class=\"muted small\" style=\"display:block;margin-top:0.25rem;\">\n        Non-profits and education get 40 % off any paid plan. Startups under 2 years old qualify for 3 months of Pro free. <a href=\"#\" style=\"color:var(--accent,#5b6abf);\">Email sales</a> with your details.\n      </span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const toggle = document.getElementById('billing-toggle');\n  const toggleText = document.getElementById('toggle-text');\n  const saveBadge = document.getElementById('save-badge');\n  const monthlyLabel = document.getElementById('billing-monthly-label');\n  const yearlyLabel = document.getElementById('billing-yearly-label');\n  const proNote = document.getElementById('pro-yearly-note');\n  const teamNote = document.getElementById('team-yearly-note');\n  let yearly = false;\n\n  toggle.addEventListener('click', function(){\n    yearly = !yearly;\n    toggleText.textContent = yearly ? 'Switch to monthly' : 'Switch to yearly';\n    saveBadge.style.display = yearly ? 'none' : '';\n    monthlyLabel.style.opacity = yearly ? '0.5' : '1';\n    yearlyLabel.style.opacity = yearly ? '1' : '0';\n    proNote.style.opacity = yearly ? '1' : '0';\n    teamNote.style.opacity = yearly ? '1' : '0';\n\n    document.querySelectorAll('[data-monthly]').forEach(function(el){\n      el.textContent = yearly ? el.dataset.yearly : el.dataset.monthly;\n    });\n  });\n})();\n</script>","deltas"