dge-paid { background: #16a34a30; color: #4ade80; }\n  .badge-pending { background: #f59e0b30; color: #fbbf24; }\n  .badge-refunded { background: #dc262630; color: #f87171; }\n  .badge-failed { background: #be123c30; color: #fb7185; }\n}\n</style>\n\n<div class=\"page stack gap-lg\">\n\n  <div class=\"stack gap-sm\">\n    <h1>Orders</h1>\n    <p class=\"lead\">Manage and review recent customer orders. Search by customer name, email, or order ID; filter by payment status.</p>\n  </div>\n\n  <div class=\"grid cols-4 gap-sm\">\n    <div class=\"card center stack gap-sm\">\n      <span class=\"stat-label\">Total orders</span>\n      <span class=\"stat-value\">10</span>\n    </div>\n    <div class=\"card center stack gap-sm\">\n      <span class=\"stat-label\">Revenue (paid)</span>\n      <span class=\"stat-value down\" style=\"color:var(--accent)\">€1,207.25</span>\n    </div>\n    <div class=\"card center stack gap-sm\">\n      <span class=\"stat-label\">Pending</span>\n      <span class=\"stat-value\">3</span>\n    </div>\n    <div class=\"card center stack gap-sm\">\n      <span class=\"stat-label\">Issues</span>\n      <span class=\"stat-value\" style=\"color:#dc2626\">2</span>\n      <span class=\"small muted\">1 failed · 1 refunded</span>\n    </div>\n  </div>\n\n  <div class=\"card stack gap-lg\">\n    <div>\n      <h2 class=\"card-title\">Order list</h2>\n      <p class=\"card-desc\">Showing all orders — Oct 2026</p>\n    </div>\n\n    <div class=\"filter-bar\">\n      <label>\n        <span class=\"small\" style=\"margin-bottom:.25rem;display:block\">Search</span>\n        <input type=\"search\" id=\"searchInput\" placeholder=\"Customer, email, or order #…\" />\n      </label>\n      <label>\n        <span class=\"small\" style=\"margin-bottom:.25rem;display:block\">Status</span>\n        <select id=\"statusFilter\">\n          <option value=\"all\">All statuses</option>\n          <option value=\"paid\">Paid</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"refunded\">Refunded</option>\n          <option value=\"failed\">Failed</option>\n        </select>\n      </label>\n      <button class=\"btn btn-secondary btn-sm\" id=\"resetBtn\" style=\"align-self:flex-end;margin-bottom:1px\">Clear</button>\n    </div>\n\n    <div style=\"overflow-x:auto\">\n      <table id=\"ordersTable\">\n        <thead>\n          <tr>\n            <th>Order</th>\n            <th>Customer</th>\n            <th>Amount</th>\n            <th>Items</th>\n            <th>Method</th>\n            <th>Date</th>\n            <th>Status</th>\n          </tr>\n        </thead>\n        <tbody id=\"ordersBody\"></tbody>\n      </table>\n      <div id=\"emptyState\" class=\"empty-state\" style=\"display:none\">\n        <p>No orders match your search or filter.</p>\n        <p class=\"small muted\">Try a different term or select \"All statuses\".</p>\n      </div>\n    </div>\n\n    <p class=\"small muted\" id=\"rowCount\">Showing 10 of 10 orders</p>\n  </div>\n\n</div>\n\n<script>\n(function () {\n  const orders = [\n    { id: 1041, customer: \"Ada Lovelace\", email: \"ada@example.com\", status: \"paid\", amount: 240, date: \"2026-10-02\", items: 3, method: \"Card\" },\n    { id: 1042, customer: \"Linus Torvalds\", email: \"linus@example.com\", status: \"pending\", amount: 89.5, date: \"2026-10-03\", items: 1, method: \"Bank transfer\" },\n    { id: 1043, customer: \"Grace Hopper\", email: \"grace@example.com\", status: \"refunded\", amount: 120, date: \"2026-10-05\", items: 2, method: \"Card\" },\n    { id: 1044, customer: \"Alan Turing\", email: \"alan@example.com\", status: \"paid\", amount: 310.25, date: \"2026-10-08\", items: 4, method: \"PayPal\" },\n    { id: 1045, customer: \"Margaret Hamilton\", email: \"margaret@example.com\", status: \"paid\", amount: 64, date: \"2026-10-11\", items: 1, method: \"Card\" },\n    { id: 1046, customer: \"Ken Thompson\", email: \"ken@example.com\", status: \"pending\", amount: 199.99, date: \"2026-10-14\", items: 2, method: \"Bank transfer\" },\n    { id: 1047, customer: \"Barbara Liskov\", email: \"barbara@example.com\", status: \"paid\", amount: 455, date: \"2026-10-15\", items: 5, method: \"Card\" },\n    { id: 1048, customer: \"Dennis Ritchie\", email: \"dennis@example.com\", status: \"failed\", amount: 72.4, date: \"2026-10-17\", items: 1, method: \"Card\" },\n    { id: 1049, customer: \"Radia Perlman\", email: \"radia@example.com\", status: \"paid\", amount: 138, date: \"2026-10-19\", items: 2, method: \"PayPal\" },\n    { id: 1050, customer: \"Donald Knuth\", email: \"donald@example.com\", status: \"pending\", amount: 520.75, date: \"2026-10-21\", items: 6, method: \"Bank transfer\" }\n  ];\n\n  const body = document.getElementById(\"ordersBody\");\n  const empty = document.getElementById(\"emptyState\");\n  const countEl = document.getElementById(\"rowCount\");\n  const search = document.getElementById(\"searchInput\");\n  const filter = document.getElementById(\"statusFilter\");\n  const reset = document.getElementById(\"resetBtn\");\n\n  const badgeClass = { paid: \"badge-paid\", pending: \"badge-pending\", refunded: \"badge-refunded\", failed: \"badge-failed\" };\n  const badgeLabel = { paid: \"Paid\", pending: \"Pending\", refunded: \"Refunded\", failed: \"Failed\" };\n\n  function fmt(n) { return \"€\" + n.toFixed(2).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); }\n\n  function initials(name) {\n    return name.split(\" \").map(w => w[0]).join(\"\").toUpperCase();\n  }\n\n  function render() {\n    const q = search.value.toLowerCase().trim();\n    const s = filter.value;\n\n    const filtered = orders.filter(o => {\n      const matchSearch = !q ||\n        o.customer.toLowerCase().includes(q) ||\n        o.email.toLowerCase().includes(q) ||\n        String(o.id).includes(q);\n      const matchStatus = s === \"all\" || o.status === s;\n      return matchSearch && matchStatus;\n    });\n\n    body.innerHTML = \"\";\n\n    if (filtered.length === 0) {\n      empty.style.display = \"block\";\n      document.getElementById(\"ordersTable\").style.display = \"none\";\n    } else {\n      empty.style.display = \"none\";\n      document.getElementById(\"ordersTable\").style.display = \"\";\n\n      filtered.forEach(o => {\n        const tr = document.createElement(\"tr\");\n        tr.innerHTML = `\n          <td class=\"num\" style=\"white-space:nowrap\">#${o.id}</td>\n          <td style=\"white-space:nowrap\">\n            <span class=\"avatar\">${initials(o.customer)}</span>\n            <div class=\"stack\" style=\"gap:0;display:inline-flex;flex-direction:column;vertical-align:middle\">\n              <span style=\"font-weight:600\">${o.customer}</span>\n              <span class=\"small muted\">${o.email}</span>\n            </div>\n          </td>\n          <td class=\"num amount-cell\">${fmt(o.amount)}</td>\n          <td class=\"num\">${o.items}</td>\n          <td>${o.method}</td>\n          <td style=\"white-space:nowrap\">${o.date}</td>\n          <td><span class=\"badge ${badgeClass[o.status]}\">${badgeLabel[o.status]}</span></td>\n        `;\n        body.appendChild(tr);\n      });\n    }\n\n    countEl.textContent = `Showing ${filtered.length} of ${orders.length} orders`;\n  }\n\n  search.addEventListener(\"input\", render);\n  filter.addEventListener(\"change\", render);\n  reset.addEventListener(\"click\", () => {\n    search.value = \"\";\n    filter.value = \"all\";\n    render();\n  });\n\n  render();\n})();\n</script>","deltas":[[4803,"<style"],[4859,">\n.filter-bar"],[4933," { display:"],[5013," flex; gap:"],[5024," "],[5024,"1rem; flex"],[5024,"-wrap:"],[5094," wrap; align-items"],[5197,": flex-end;"],[5236," }\n.filter-bar"],[5245," label"],[5245," { flex: "],[5348,"1; min-width"],[5356,": 18"],[5356,"0px;"],[5502," }\n.filter-bar"],[5510," label"],[5538,":first-child { flex"],[5549,":"],[5573," 2; min"],[5582,"-width: 2"],[5646,"60px;"],[5759," }\ntable"],[5834," tbod