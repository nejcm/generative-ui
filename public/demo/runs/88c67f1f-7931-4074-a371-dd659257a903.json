class=\"row between gap-sm\" style=\"margin-bottom:1rem;\">\n      <div style=\"display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;\">\n        <input type=\"search\" id=\"search\" placeholder=\"Search by name, email, or ID…\" style=\"padding:0.45rem 0.7rem; border:1px solid var(--border); border-radius:6px; font-size:0.9rem; min-width:220px;\">\n        <select id=\"statusFilter\" style=\"padding:0.45rem 0.7rem; border:1px solid var(--border); border-radius:6px; font-size:0.9rem;\">\n          <option value=\"\">All statuses</option>\n          <option value=\"paid\">Paid</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"refunded\">Refunded</option>\n          <option value=\"failed\">Failed</option>\n        </select>\n      </div>\n      <span class=\"muted small\" id=\"resultCount\">Showing 10 of 10</span>\n    </div>\n\n    <div style=\"overflow-x:auto;\">\n      <table>\n        <thead>\n          <tr>\n            <th>ID</th>\n            <th>Customer</th>\n            <th>Status</th>\n            <th>Amount</th>\n            <th>Items</th>\n            <th>Method</th>\n            <th>Date</th>\n          </tr>\n        </thead>\n        <tbody id=\"ordersBody\"></tbody>\n      </table>\n    </div>\n  </div>\n\n  <div class=\"row gap-sm\" style=\"margin-top:1rem;\">\n    <div class=\"card\" style=\"flex:1;\">\n      <div class=\"card-title\">Status Breakdown</div>\n      <table>\n        <thead><tr><th>Status</th><th class=\"num\">Count</th><th class=\"num\">Amount</th><th class=\"num\">Share</th></tr></thead>\n        <tbody>\n          <tr><td><span class=\"badge\">Paid</span></td><td class=\"num\">5</td><td class=\"num\">€1,207.25</td><td class=\"num\">54.6%</td></tr>\n          <tr><td><span class=\"badge-secondary\">Pending</span></td><td class=\"num\">3</td><td class=\"num\">€810.24</td><td class=\"num\">36.7%</td></tr>\n          <tr><td><span class=\"badge-outline\">Refunded</span></td><td class=\"num\">1</td><td class=\"num\">€120.00</td><td class=\"num\">5.4%</td></tr>\n          <tr><td><span class=\"badge-destructive\">Failed</span></td><td class=\"num\">1</td><td class=\"num\">€72.40</td><td class=\"num\">3.3%</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<script>\nconst orders = [\n  {id:1041,customer:\"Ada Lovelace\",email:\"ada@example.com\",status:\"paid\",amount:240,date:\"2026-10-02\",items:3,method:\"Card\"},\n  {id:1042,customer:\"Linus Torvalds\",email:\"linus@example.com\",status:\"pending\",amount:89.5,date:\"2026-10-03\",items:1,method:\"Bank transfer\"},\n  {id:1043,customer:\"Grace Hopper\",email:\"grace@example.com\",status:\"refunded\",amount:120,date:\"2026-10-05\",items:2,method:\"Card\"},\n  {id:1044,customer:\"Alan Turing\",email:\"alan@example.com\",status:\"paid\",amount:310.25,date:\"2026-10-08\",items:4,method:\"PayPal\"},\n  {id:1045,customer:\"Margaret Hamilton\",email:\"margaret@example.com\",status:\"paid\",amount:64,date:\"2026-10-11\",items:1,method:\"Card\"},\n  {id:1046,customer:\"Ken Thompson\",email:\"ken@example.com\",status:\"pending\",amount:199.99,date:\"2026-10-14\",items:2,method:\"Bank transfer\"},\n  {id:1047,customer:\"Barbara Liskov\",email:\"barbara@example.com\",status:\"paid\",amount:455,date:\"2026-10-15\",items:5,method:\"Card\"},\n  {id:1048,customer:\"Dennis Ritchie\",email:\"dennis@example.com\",status:\"failed\",amount:72.4,date:\"2026-10-17\",items:1,method:\"Card\"},\n  {id:1049,customer:\"Radia Perlman\",email:\"radia@example.com\",status:\"paid\",amount:138,date:\"2026-10-19\",items:2,method:\"PayPal\"},\n  {id:1050,customer:\"Donald Knuth\",email:\"donald@example.com\",status:\"pending\",amount:520.75,date:\"2026-10-21\",items:6,method:\"Bank transfer\"}\n];\n\nconst badgeMap = {paid:\"badge\",pending:\"badge-secondary\",refunded:\"badge-outline\",failed:\"badge-destructive\"};\n\nfunction render() {\n  const q = document.getElementById(\"search\").value.toLowerCase();\n  const status = document.getElementById(\"statusFilter\").value;\n  const filtered = orders.filter(o => {\n    const matchQ = !q || o.customer.toLowerCase().includes(q) || o.email.includes(q) || String(o.id).includes(q);\n    const matchS = !status || o.status === status;\n    return matchQ && matchS;\n  });\n  const tbody = document.getElementById(\"ordersBody\");\n  tbody.innerHTML = filtered.map(o => `<tr>\n    <td>#${o.id}</td>\n    <td>${o.customer}<br><span class=\"muted small\">${o.email}</span></td>\n    <td><span class=\"${badgeMap[o.status]}\">${o.status.charAt(0).toUpperCase()+o.status.slice(1)}</span></td>\n    <td class=\"num\">€${o.amount.toFixed(2)}</td>\n    <td class=\"num\">${o.items}</td>\n    <td>${o.method}</td>\n    <td>${o.date}</td>\n  </tr>`).join(\"\");\n  if (!filtered.length) {\n    tbody.innerHTML = `<tr><td colspan=\"7\" class=\"muted\" style=\"text-align:center;padding:1.5rem;\">No orders match the current filters.</td></tr>`;\n  }\n  document.getElementById(\"resultCount\").textContent = `Showing ${filtered.length} of ${orders.length}`;\n}\n\ndocument.getElementById(\"search\").addEventListener(\"input\", render);\ndocument.getElementById(\"statusFilter\").addEventListener(\"change\", render);\nrender();\n</script>","deltas":[[12946,"\n\n<div"],[12978," class"],[13019,"=\""],[13025,"page"],[13054,"\">"],[13079,"\n"],[13106," "],[13143," "],[13159,"<h"],[13185,"1"],[13212,">"],[13256,"Orders"],[13290,"</h"],[13328,"1"],[13344,">"],[13373,"\n"],[13396," "],[13425," "],[13475,"<p class"],[13502,"=\""],[13527,"lead"],[13554,"\">"],[13600,"Track"],[13608," and"],[13633," manage"],[13685," all"],[13716," customer"],[13720," orders"],[13761,"."],[13804," Use"],[13812," the"],[13830," search"],[13869," and"],[13871," filter"],[13911," controls"],[13928," to"],[13952," narrow"],[13978," down"],[14009," the"],[14030," list"],[14059,"."],[14109,"</p>"],[14136,"\n\n"],[14173," "],[14195," "],[14220,"<div"],[14242," class"],[14268,"=\""],[14295,