iv>\n      <p>Best for <strong>students and light office work</strong>, with the lowest price, lightest weight, and longest battery life.</p>\n      <div class=\"metric-list small\">\n        <div><span>Battery</span><strong>22 hours</strong></div>\n        <div><span>Weight</span><strong>1.0 kg</strong></div>\n        <div><span>Rating</span><strong>4.2 / 5</strong></div>\n      </div>\n    </article>\n  </section>\n\n  <section class=\"stack gap-sm\" aria-labelledby=\"headline-comparison\">\n    <div>\n      <h2 id=\"headline-comparison\">Side-by-side specifications</h2>\n      <p class=\"muted\">The key trade-offs are portability versus performance, and premium features versus price.</p>\n    </div>\n\n    <div class=\"card comparison-scroll\">\n      <table class=\"table comparison-table\">\n        <thead>\n          <tr>\n            <th scope=\"col\">Specification</th>\n            <th scope=\"col\">Aero 14</th>\n            <th scope=\"col\">Forge 16</th>\n            <th scope=\"col\">Nimbus 13</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th scope=\"row\">Price</th>\n            <td class=\"num\">$1,299</td>\n            <td class=\"num\">$1,899</td>\n            <td class=\"num\">$999</td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Tagline</th>\n            <td>Light, bright, long-lasting</td>\n            <td>Desktop power on the go</td>\n            <td>Everything you need, for less</td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Weight</th>\n            <td class=\"num\">1.2 kg</td>\n            <td class=\"num\">2.1 kg</td>\n            <td class=\"num\">1.0 kg</td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Battery life</th>\n            <td class=\"num\">18 hours</td>\n            <td class=\"num\">9 hours</td>\n            <td class=\"num\">22 hours</td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Display</th>\n            <td