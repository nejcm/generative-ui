le\" id=\"orders\">\n    <thead><tr><th>ID</th><th>Customer</th><th>Status</th><th>Amount</th><th>Date</th><th>Items</th><th>Method</th></tr></thead>\n    <tbody></tbody>\n  </table>\n</div>\n\n<script>\nconst data = [{\"id\":1041,\"customer\":\"Ada Lovelace\",\"email\":\"ada@example.com\",\"status\":\"paid\",\"amount\":240,\"date\":\"2026-10-02\",\"items\":3,\"method\":\"Card\"},{\"id\":1042,\"customer\":\"Linus Torvalds\",\"email\":\"linus@example.com\",\"status\":\"pending\",\"amount\":89.5,\"date\":\"2026-10-03\",\"items\":1,\"method\":\"Bank transfer\"},{\"id\":1043,\"customer\":\"Grace Hopper\",\"email\":\"grace@example.com\",\"status\":\"refunded\",\"amount\":120,\"date\":\"2026-10-05\",\"items\":2,\"method\":\"Card\"},{\"id\":1044,\"customer\":\"Alan Turing\",\"email\":\"alan@example.com\",\"status\":\"paid\",\"amount\":310.25,\"date\":\"2026-10-08\",\"items\":4,\"method\":\"PayPal\"},{\"id\":1045,\"customer\":\"Margaret Hamilton\",\"email\":\"margaret@example.com\",\"status\":\"paid\",\"amount\":64,\"date\":\"2026-10-11\",\"items\":1,\"method\":\"Card\"},{\"id\":1046,\"customer\":\"Ken Thompson\",\"email\":\"ken@example.com\",\"status\":\"pending\",\"amount\":199.99,\"date\":\"2026-10-14\",\"items\":2,\"method\":\"Bank transfer\"},{\"id\":1047,\"customer\":\"Barbara Liskov\",\"email\":\"barbara@example.com\",\"status\":\"paid\",\"amount\":455,\"date\":\"2026-10-15\",\"items\":5,\"method\":\"Card\"},{\"id\":1048,\"customer\":\"Dennis Ritchie\",\"email\":\"dennis@example.com\",\"status\":\"failed\",\"amount\":72.4,\"date\":\"2026-10-17\",\"items\":1,\"method\":\"Card\"},{\"id\":1049,\"customer\":\"Radia Perlman\",\"email\":\"radia@example.com\",\"status\":\"paid\",\"amount\":138,\"date\":\"2026-10-19\",\"items\":2,\"method\":\"PayPal\"},{\"id\":1050,\"customer\":\"Donald Knuth\",\"email\":\"donald@example.com\",\"status\":\"pending\",\"amount\":520.75,\"date\":\"2026-10-21\",\"items\":6,\"method\":\"Bank transfer\"}];\n\nfunction render(rows) {\n  const tbody = document.querySelector('#orders tbody');\n  tbody.innerHTML = rows.map(r => `<tr>\n    <td>${r.id}</td><td>${r.customer}</td>\n    <td><span class=\"badge ${r.status==='paid'?'badge-secondary':r.status==='pending'?'badge-outline':r.status==='failed'?'badge-destructive':'badge-outline'}\">${r.status}</span></td>\n    <td class=\"num\">$${r.amount.toFixed(2)}</td><td>${r.date}</td><td>${r.items}</td><td>${r.method}</td>\n  </tr>`).join('');\n}\n\nfunction filterOrders() {\n  const q = document.getElementById('q').value.toLowerCase();\n  const checks = ['paid','pending','failed','refunded'].filter(s => document.getElementById('f-'+s).checked);\n  const filtered = data.filter(r => {\n    const matchText = r.customer.toLowerCase().includes(q) || String(r.id).includes(q);\n    const matchStatus = checks.length ? checks.includes(r.status) : true;\n    return matchText && matchStatus;\n  });\n  render(filtered);\n}\n\nrender(data);\n</script>","deltas":[[2173,"<div class=\"page stack gap-lg\">\n  <div>\n    <h1>Orders</h1>\n    <p class=\"lead muted\">Search and filter recent orders.</p>\n  </div>\n\n  <div class=\"row gap-sm\" style=\"align-items:center\">\n    <label>Search <input id=\"q\" placeholder=\"Customer / ID...\" oninput=\"filterOrders()\"></label>\n    <label class=\"check\">Paid <input type=\"checkbox\" onchange=\"filterOrders()\" id=\"f-paid\"></label>\n    <label class=\"check\">Pending <input type=\"checkbox\" onchange=\"filterOrders()\" id=\"f-pending\"></label>\n    <label class=\"check\">Failed <input type=\"checkbox\" onchange=\"filterOrders()\" id=\"f-failed\"></label>\n    <label class=\"check\">Refunded <input type=\"checkbox\" onchange=\"filterOrders()\" id=\"f-refunded\"></label>\n  </div>\n\n  <table class=\"table\" id=\"orders\">\n    <thead><tr><th>ID</th><th>Customer</th><th>Status</th><th>Amount</th><th>Date</th><th>Items</th><th>Method</th></tr></thead>\n    <tbody></tbody>\n  </table>\n</div>\n\n<script>\nconst"],[3170," data = [{\"id\":10