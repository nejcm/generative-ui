\">\n      <thead>\n        <tr><th>Spec</th><th>Aero 14</th><th>Forge 16</th><th>Nimbus 13</th></tr>\n      </thead>\n      <tbody>\n        <tr><td>Price</td><td class=\"num\">$1,299</td><td class=\"num\">$1,899</td><td class=\"num up\">$999</td></tr>\n        <tr><td>Weight</td><td class=\"num\">1.2 kg</td><td class=\"num\">2.1 kg</td><td class=\"num up\">1.0 kg</td></tr>\n        <tr><td>Battery life</td><td class=\"num\">18 h</td><td class=\"num\">9 h</td><td class=\"num up\">22 h</td></tr>\n        <tr><td>Screen</td><td>14\" OLED</td><td>16\" IPS 165Hz</td><td>13\" IPS</td></tr>\n        <tr><td>CPU</td><td>8-core, 15 W</td><td class=\"up\">16-core, 55 W</td><td>6-core, 15 W</td></tr>\n        <tr><td>RAM</td><td class=\"num\">16 GB</td><td class=\"num up\">32 GB</td><td class=\"num\">16 GB</td></tr>\n        <tr><td>Storage</td><td class=\"num\">512 GB</td><td class=\"num up\">1,024 GB</td><td class=\"num\">256 GB</td></tr>\n        <tr><td>Ports</td>\n          <td class=\"small\">2x USB-C · HDMI · headphone</td>\n          <td class=\"small up\">2x USB-C · 3x USB-A · HDMI · Ethernet · SD card</td>\n          <td class=\"small\">2x USB-C · headphone</td></tr>\n        <tr><td>Owner rating</td><td class=\"num up\">★ 4.6</td><td class=\"num\">★ 4.4</td><td class=\"num\">★ 4.2</td></tr>\n        <tr><td>Reviews</td><td class=\"num\">1,840</td><td class=\"num\">960</td><td class=\"num up\">2,310</td></tr>\n        <tr><td>Cost per GB of storage</td><td class=\"num\">$2.54</td><td class=\"num up\">$1.85</td><td class=\"num\">$3.90</td></tr>\n        <tr><td>Best for</td>\n          <td class=\"small\">Travel and everyday work</td>\n          <td class=\"small\">Video editing, 3D and gaming</td>\n          <td class=\"small\">Students and light office work</td></tr>\n      </tbody>\n    </table>\n    <p class=\"muted small\">Screen row has no single winner: the Aero's OLED is the best for colour and contrast, the Forge's 165 Hz panel is the smoothest for games, t