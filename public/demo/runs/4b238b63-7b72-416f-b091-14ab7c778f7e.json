tack gap-sm\" style=\"list-style:none;padding:0;margin:0\">\n        <li>✓ Up to 3 projects</li>\n        <li>✓ 1 user</li>\n        <li>✓ 1 GB storage</li>\n        <li>✓ Basic analytics</li>\n        <li>✓ Community support</li>\n        <li class=\"muted\">– Automations</li>\n        <li class=\"muted\">– Shared workspaces</li>\n      </ul>\n    </div>\n\n    <div class=\"card stack\" style=\"border:2px solid currentColor\">\n      <div>\n        <div class=\"row between\"><h3 class=\"h3\">Pro</h3><span class=\"badge\">Most popular</span></div>\n        <p class=\"card-desc\">For professionals who need power and room to grow.</p>\n      </div>\n      <div class=\"row gap-sm\" style=\"align-items:baseline\">\n        <span class=\"stat-value\" data-m=\"$15\" data-y=\"$12\">$15</span><span class=\"muted\" data-period>per month</span>\n      </div>\n      <p class=\"small muted\" data-note>Billed monthly</p>\n      <a class=\"btn btn-block\" href=\"#\">Start 14-day free trial</a>\n      <hr class=\"hr\">\n      <ul class=\"stack gap-sm\" style=\"list-style:none;padding:0;margin:0\">\n        <li>✓ Unlimited projects</li>\n        <li>✓ 1 user</li>\n        <li>✓ 100 GB storage</li>\n        <li>✓ Advanced analytics</li>\n        <li>✓ Automations (up to 50 runs/day)</li>\n        <li>✓ Custom domains</li>\n        <li>✓ Priority email support</li>\n      </ul>\n    </div>\n\n    <div class=\"card stack\">\n      <div>\n        <h3 class=\"h3\">Team</h3>\n        <p class=\"card-desc\">For teams that collaborate and need control and security.</p>\n      </div>\n      <div class=\"row gap-sm\" style=\"align-items:baseline\">\n        <span class=\"stat-value\" data-m=\"$12\" data-y=\"$10\">$12</span><span class=\"muted\" data-teamperiod>per user / month</span>\n      </div>\n      <p class=\"small muted\" data-note>Billed monthly · minimum 3 users</p>\n      <a class=\"btn btn-secondary btn-block\" href=\"#\">Contact sales</a>\n      <hr class=\"hr\">\n      <ul class