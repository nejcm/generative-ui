?</strong> Retry, then contact support with the request ID above.</div>';\n    }\n\n    emptyBtn.addEventListener('click', renderEmpty);\n    errorBtn.addEventListener('click', renderError);\n\n    group.appendChild(emptyBtn);\n    group.appendChild(errorBtn);\n    bar.appendChild(label);\n    bar.appendChild(group);\n\n    wrap.appendChild(bar);\n    wrap.appendChild(panel);\n\n    var target = document.querySelector('h1').parentNode;\n    target.insertBefore(wrap, target.querySelector('.grid'));\n\n    renderEmpty();\n  })();\n</script>","deltas":[[2173,"<h1>Your files</h1>\n<p class=\"lead\">Everything you upload stays"],[2275," in this workspace. Files are scanned, indexed and searchable within"],[2414," seconds.</p>\n\n<div class=\"row between center"],[2534," gap-sm\">\n  <div class=\"row gap-sm\">\n    <button class=\"btn\">Upload files</button>\n    <button class=\"btn btn-outline\">New"],[2716," folder</button>\n  </div>\n  <div class=\"row"],[2850," gap-sm\">\n    <label class=\"label\" style=\"margin:0\">\n      <span class=\"small muted"],[2960,"\">Sort by</span>\n      <select class=\"input\">\n        <option>Last modified</option>\n        <option>Name"],[3089,"</option>\n        <option>Size</option>\n      </select>\n    </label>\n  </div>\n</div>\n\n<div class=\"grid"],[3210," cols-2\" style=\"margin-top:24px\">\n\n <div class=\"card\">\n    <div class=\"card-title\">Empty state</div>\n    "],[3326,"<p class=\"card-desc\">No files yet. This is the first thing"],[3437," a new workspace sees"],[3594,", so it should explain the value and point straight at the action.</p>\n    <hr>\n\n    <div class=\"stack\" style=\"text-align:center;padding:28px 8"],[3705,"px\">\n      <div class=\"avatar"],[3840,"\" style=\"width:56px;height:56px;border-radius:14px;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:24px\">&#859"],[3953,"3;</div>\n      <h3 style=\"margin:0\">"],[4125,"Nothing here yet</h3>\n      <p class=\"muted\" style=