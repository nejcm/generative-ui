h>Items</th>\n              <th>Method</th>\n              <th>Status</th>\n              <th class=\"num\">Amount</th>\n              <th></th>\n            </tr>\n          </thead>\n          <tbody></tbody>\n        </table>\n      </div>\n\n      <div class=\"alert\" id=\"emptyState\" style=\"display: none;\">\n        No orders match your search. Try a different name, email or status filter.\n      </div>\n    </section>\n\n    <section class=\"card stack gap-lg\">\n      <div class=\"row between\" style=\"flex-wrap: wrap;\">\n        <h3 class=\"card-title\" style=\"margin:0;\">Revenue by payment method</h3>\n        <span class=\"small muted\">Paid orders only, October 2026</span>\n      </div>\n      <div data-chart='{\"type\":\"bar\",\"title\":\"Revenue by payment method\",\"data\":[{\"label\":\"Card\",\"value\":759.0},{\"label\":\"PayPal\",\"value\":448.25}]}'></div>\n      <p class=\"small muted\">Card payments account for roughly 63% of settled revenue; the remaining 37% came via PayPal. Bank transfer orders are still pending and not yet included.</p>\n    </section>\n\n  </div>\n</div>\n\n<style>\n  #ordersTable td.num { font-variant-numeric: tabular-nums; }\n  #ordersTable tbody tr { border-bottom: 1px solid var(--border, rgba(128,128,128,.2)); }\n  .avatar { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; font-size: .75rem; font-weight: 600; background: rgba(128,128,128,.15); }\n</style>\n\n<script>\n(function () {\n  var orders = [\n    { id: 1041, customer: \"Ada Lovelace\", email: \"ada@example.com\", status: \"paid\", amount: 240, date: \"2026-10-02\", items: 3, method: \"Card\" },\n    { id: 1042, customer: \"Linus Torvalds\", email: \"linus@example.com\", status: \"pending\", amount: 89.5, date: \"2026-10-03\", items: 1, method: \"Bank transfer\" },\n    { id: 1043, customer: \"Grace Hopper\", email: \"grace@example.com\", status: \"refunded\", amount: 120, date: \"2026-10-05\", items: 2, method: \"Card\" },\n    { id: 1044, customer: \"Alan Turing\", email: \"alan@example.com\", status: \"paid\", amount: 310.25, date: \"2026-10-08\", items: 4, method: \"PayPal\" },\n    { id: 1045, customer: \"Margaret Hamilton\", email: \"margaret@example.com\", status: \"paid\", amount: 64, date: \"2026-10-11\", items: 1, method: \"Card\" },\n    { id: 1046, customer: \"Ken Thompson\", email: \"ken@example.com\", status: \"pending\", amount: 199.99, date: \"2026-10-14\", items: 2, method: \"Bank transfer\" },\n    { id: 1047, customer: \"Barbara Liskov\", email: \"barbara@example.com\", status: \"paid\", amount: 455, date: \"2026-10-15\", items: 5, method: \"Card\" },\n    { id: 1048, customer: \"Dennis Ritchie\", email: \"dennis@example.com\", status: \"failed\", amount: 72.4, date: \"2026-10-17\", items: 1, method: \"Card\" },\n    { id: 1049, customer: \"Radia Perlman\", email: \"radia@example.com\", status: \"paid\", amount: 138, date: \"2026-10-19\", items: 2, method: \"PayPal\" },\n    { id: 1050, customer: \"Donald Knuth\", email: \"donald@example.com\", status: \"pending\", amount: 520.75, date: \"2026-10-21\", items: 6, method: \"Bank transfer\" }\n  ];\n\n  var badgeClass = { paid: \"badge\", pending: \"badge badge-secondary\", refunded: \"badge badge-outline\", failed: \"badge badge-destructive\" };\n\n  var searchInput = document.getElementById(\"search\");\n  var statusFilter = document.getElementById(\"statusFilter\");\n  var clearBtn = document.getElementById(\"clearBtn\");\n  var tbody = document.querySelector(\"#ordersTable tbody\");\n  var resultCount = document.getElementById(\"resultCount\");\n  var emptyState = document.getElementById(\"emptyState\");\n\n  function initials(name) {\n    return name.split(\" \").map(function (p) { return p[0]; }).join(\"\").slice(0, 2).toUpperCase();\n  }\n\n  function fmtDate(d) {\n    var months = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"];\n    var p = d.split(\"-\");\n    return months[parseInt(p[1], 10) - 1] + \" \" + parseInt(p[2], 10) + \", \" + p[0];\n  }\n\n  function fmtMoney(n) {\n    return \"$\" + n.toLocaleString(\"en-US\", { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  }\n\n  function render() {\n    var q = searchInput.value.trim().toLowerCase();\n    var status = statusFilter.value;\n    var rows = orders.filter(function (o) {\n      var matchesQ = !q ||\n        o.customer.toLowerCase().indexOf(q) !== -1 ||\n        o.email.toLowerCase().indexOf(q) !== -1 ||\n        String(o.id).indexOf(q) !== -1;\n      var matchesS = status === \"all\" || o.status === status;\n      return matchesQ && matchesS;\n    });\n\n    tbody.innerHTML = rows.map(function (o) {\n      return \"<tr>\" +\n        '<td><strong>#' + o.id + \"</strong></td>\" +\n        '<td><div class=\"row\" style=\"gap:.5rem; align-items:center;\">' +\n          '<span class=\"avatar\">' + initials(o.customer) + \"</span>\" +\n          '<span><div>' + o.customer + '</div><div class=\"small muted\">' + o.email + \"</div></span>\" +\n        \"</div></td>\" +\n        \"<td>\" + fmtDate(o.date) + \"</td>\" +\n        '<td class=\"num\">' + o.items + \"</td>\" +\n        \"<td>\" + o.method + \"</td>\" +\n        '<td><span class=\"' + badgeClass[o.status] + '\">' + o.status.charAt(0).toUpperCase() + o.status.slice(1) + \"</span></td>\" +\n        '<td class=\"num\"><strong>' + fmtMoney(o.amount) + \"</strong></td>\" +\n        '<td><button class=\"btn btn-ghost btn-sm\" data-id=\"' + o.id + '\">View</button></td>' +\n        \"</tr>\";\n    }).join(\"\");\n\n    resultCount.textContent = rows.length === orders.length\n      ? \"All \" + rows.length + \" orders shown\"\n      : rows.length + \" of \" + orders.length + \" orders shown\";\n\n    emptyState.style.display = rows.length ? \"none\" : \"block\";\n    document.querySelector(\"#ordersTable\").style.display = rows.length ? \"\" : \"none\";\n  }\n\n  searchInput.ad