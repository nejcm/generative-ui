n    \n    <div class=\"row gap-lg\">\n      <div class=\"card\" style=\"flex: 0 0 260px;\">\n        <div class=\"card-title\">Status Breakdown</div>\n        <div data-chart='{\"type\":\"pie\",\"title\":\"Orders by Status\",\"data\":[{\"label\":\"Paid\",\"value\":5},{\"label\":\"Pending\",\"value\":3},{\"label\":\"Refunded\",\"value\":1},{\"label\":\"Failed\",\"value\":1}]}'></div>\n      </div>\n      \n      <div class=\"card\" style=\"flex: 1; min-width: 0;\">\n        <div class=\"between center\" style=\"margin-bottom: 1rem;\">\n          <div class=\"card-title\" style=\"margin:0;\">All Orders</div>\n          <span class=\"muted\" id=\"resultCount\">Showing 10 orders</span>\n        </div>\n        \n        <div class=\"row gap-sm\">\n          <label style=\"flex:1\">\n            Search\n            <input type=\"text\" id=\"searchInput\" placeholder=\"Customer or email...\">\n          </label>\n          <label>\n            Status\n            <select id=\"statusFilter\">\n              <option value=\"all\">All</option>\n              <option value=\"paid\">Paid</option>\n              <option value=\"pending\">Pending</option>\n              <option value=\"refunded\">Refunded</option>\n              <option value=\"failed\">Failed</option>\n            </select>\n          </label>\n        </div>\n        \n        <div style=\"overflow-x: auto; margin-top: 1rem;\">\n          <table class=\"table\">\n            <thead>\n              <tr>\n                <th>ID</th>\n                <th>Customer</th>\n                <th>Email</th>\n                <th>Status</th>\n                <th class=\"num\">Amount</th>\n                <th>Date</th>\n                <th class=\"num\">Items</th>\n                <th>Method</th>\n              </tr>\n            </thead>\n            <tbody id=\"ordersBody\"></tbody>\n          </table>\n        </div>\n        <p id=\"noResults\" class=\"muted\" style=\"display:none; text-align:center; padding: 2rem 0;\">No orders match your filters.</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nconst orders = [\n  {\"id\":1041,\"customer\":\"Ada Lovelace\",\"email\":\"ada@example.com\",\"status\":\"paid\",\"amount\":240,\"date\":\"2026-10-02\",\"items\":3,\"method\":\"Card\"},\n  {\"id\":1042,\"customer\":\"Linus Torvalds\",\"email\":\"linus@example.com\",\"status\":\"pending\",\"amount\":89.5,\"date\":\"2026-10-03\",\"items\":1,\"method\":\"Bank transfer\"},\n  {\"id\":1043,\"customer\":\"Grace Hopper\",\"email\":\"grace@example.com\",\"status\":\"refunded\",\"amount\":120,\"date\":\"2026-10-05\",\"items\":2,\"method\":\"Card\"},\n  {\"id\":1044,\"customer\":\"Alan Turing\",\"email\":\"alan@example.com\",\"status\":\"paid\",\"amount\":310.25,\"date\":\"2026-10-08\",\"items\":4,\"method\":\"PayPal\"},\n  {\"id\":1045,\"customer\":\"Margaret Hamilton\",\"email\":\"margaret@example.com\",\"status\":\"paid\",\"amount\":64,\"date\":\"2026-10-11\",\"items\":1,\"method\":\"Card\"},\n  {\"id\":1046,\"customer\":\"Ken Thompson\",\"email\":\"ken@example.com\",\"status\":\"pending\",\"amount\":199.99,\"date\":\"2026-10-14\",\"items\":2,\"method\":\"Bank transfer\"},\n  {\"id\":1047,\"customer\":\"Barbara Liskov\",\"email\":\"barbara@example.com\",\"status\":\"paid\",\"amount\":455,\"date\":\"2026-10-15\",\"items\":5,\"method\":\"Card\"},\n  {\"id\":1048,\"customer\":\"Dennis Ritchie\",\"email\":\"dennis@example.com\",\"status\":\"failed\",\"amount\":72.4,\"date\":\"2026-10-17\",\"items\":1,\"method\":\"Card\"},\n  {\"id\":1049,\"customer\":\"Radia Perlman\",\"email\":\"radia@example.com\",\"status\":\"paid\",\"amount\":138,\"date\":\"2026-10-19\",\"items\":2,\"method\":\"PayPal\"},\n  {\"id\":1050,\"customer\":\"Donald Knuth\",\"email\":\"donald@example.com\",\"status\":\"pending\",\"amount\":520.75,\"date\":\"2026-10-21\",\"items\":6,\"method\":\"Bank transfer\"}\n];\n\nfunction getStatusBadge(status) {\n  const map = {\n    paid: 'badge',\n    pending: 'badge-secondary',\n    refunded: 'badge-outline',\n    failed: 'badge-destructive'\n  };\n  return map[status] || 'badge';\n}\n\nfunction renderTable(data) {\n  const tbody = document.getElementById('ordersBody');\n  const noResults = document.getElementById('noResults');\n  const resultCount = document.getElementById('resultCount');\n  tbody.innerHTML = '';\n  \n  resultCount.textContent = `Showing ${data.length} order${data.length !== 1 ? 's' : ''}`;\n  \n  if (data.length === 0) {\n    noResults.style.display = 'block';\n    return;\n  }\n  noResults.style.display = 'none';\n  \n  data.forEach(order => {\n    const tr = document.createElement('tr');\n    tr.innerHTML = `\n      <td>#${order.id}</td>\n      <td>${order.customer}</td>\n      <td>${order.email}</td>\n      <td><span class=\"badge ${getStatusBadge(order.status)}\">${order.status}</span></td>\n      <td class=\"num\">$${order.amount.toFixed(2)}</td>\n      <td>${order.date}</td>\n      <td class=\"num\">${order.items}</td>\n      <td>${order.method}</td>\n    `;\n    tbody.appendChild(tr);\n  });\n}\n\nfunction filterOrders() {\n  const search = document.getElementById('searchInput').value.toLowerCase().trim();\n  const status = document.getElementById('statusFilter').value;\n  \n  const filtered = orders.filter(order => {\n    const matchesSearch = !search || \n      order.customer.toLowerCase().includes(search) || \n      order.email.toLowerCase().includes(search);\n    const matchesStatus = status === 'all' || order.status === status;\n    return matchesSearch && matchesStatus;\n  });\n  \n  renderTable(filtered);\n}\n\ndocument.getElementById('searchInput').addEventListener('input', filterOrders);\ndocument.getElementById('statusFilter').addEventListener('change', filterOrders);\n\nrenderTable(orders);\n</script>","deltas":[[48783,"<div"],[48819," class=\"page\">\n"],[48829,"  <div class"],[49012,"=\"stack gap-lg"],[49012,"\">\n    <div"],[49013,">\n      <h"],[49013,"1>Orders</"],[49013,"h1>\n     "],[49013," <p cla