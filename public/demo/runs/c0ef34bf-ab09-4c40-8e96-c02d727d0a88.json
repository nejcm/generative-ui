nual\" aria-pressed=\"false\">Annual <span class=\"save-pill\">Save 20%</span></button>\n      </div>\n    </div>\n    <p class=\"small muted\" id=\"billing-hint\">Billed monthly. Switch to annual and save 20%.</p>\n  </header>\n\n  <section class=\"grid cols-3 gap-lg\" aria-label=\"Plans\">\n\n    <article class=\"card plan-card stack gap-sm\">\n      <div class=\"plan-flag\" aria-hidden=\"true\"></div>\n      <h3>Free</h3>\n      <p class=\"muted small\">For individuals and side projects finding their feet.</p>\n      <div class=\"price-row\">\n        <span class=\"price\"><span class=\"currency\">$</span>0</span>\n        <span class=\"price-suffix\">/month</span>\n      </div>\n      <p class=\"small muted plan-note\">Free forever. No card required.</p>\n      <button type=\"button\" class=\"btn btn-outline btn-block\">Create free account</button>\n      <p class=\"small muted plan-helper\">No credit card required</p>\n      <hr>\n      <p class=\"stat-label\">What’s included</p>\n      <ul class=\"feature-list\">\n        <li><span class=\"tick\" aria-hidden=\"true\">✓</span>1 project</li>\n        <li><span class=\"tick\" aria-hidden=\"true\">✓</span>3 team members</li>\n        <li><span class=\"tick\" aria-hidden=\"true\">✓</span>2 GB storage</li>\n        <li><span class=\"tick\" aria-hidden=\"true\">✓</span>30-day version history</li>\n        <li><span class=\"tick\" aria-hidden=\"true\">✓</span>Community support</li>\n      </ul>\n    </article>\n\n    <article class=\"card plan-card plan-featured stack gap-sm\">\n      <div class=\"plan-flag\"><span class=\"badge\">Most popular</span></div>\n      <h3>Pro</h3>\n      <p class=\"muted small\">For freelancers and small teams shipping regularly.</p>\n      <div class=\"price-row\">\n        <span class=\"price\"><span class=\"currency\">$</span><span data-monthly=\"24\" data-annual=\"19\">24</span></span>\n        <span class=\"price-suffix\">/month</span>\n      </div>\n      <p class=\"small muted plan-