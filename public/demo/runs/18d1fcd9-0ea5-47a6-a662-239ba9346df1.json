-role=\"count\">3 models</span>\n    </div>\n\n    <div class=\"grid cols-3\">\n      <div class=\"card stack gap-sm\" data-model=\"Aero 14\" data-tags=\"travel\">\n        <div class=\"row between center\">\n          <h3 class=\"card-title\">Aero 14</h3>\n          <span class=\"badge\">Best all-rounder</span>\n        </div>\n        <p class=\"muted small\">Light, bright, long-lasting</p>\n        <div class=\"stat-label\">Price</div>\n        <div class=\"stat-value\">$1,299</div>\n        <div class=\"stat-label\">Weight</div>\n        <div class=\"stat-value\">1.2 kg</div>\n        <div class=\"stat-label\">Battery</div>\n        <div class=\"stat-value\">18 h</div>\n        <div class=\"progress\"><div style=\"width:82%\"></div></div>\n        <p class=\"small muted\">Best for: travel and everyday work</p>\n      </div>\n\n      <div class=\"card stack gap-sm\" data-model=\"Forge 16\" data-tags=\"power\">\n        <div class=\"row between center\">\n          <h3 class=\"card-title\">Forge 16</h3>\n          <span class=\"badge badge-destructive\">Most powerful</span>\n        </div>\n        <p class=\"muted small\">Desktop power on the go</p>\n        <div class=\"stat-label\">Price</div>\n        <div class=\"stat-value\">$1,899</div>\n        <div class=\"stat-label\">Weight</div>\n        <div class=\"stat-value\">2.1 kg</div>\n        <div class=\"stat-label\">Battery</div>\n        <div class=\"stat-value\">9 h</div>\n        <div class=\"progress\"><div style=\"width:41%\"></div></div>\n        <p class=\"small muted\">Best for: video editing, 3D and gaming</p>\n      </div>\n\n      <div class=\"card stack gap-sm\" data-model=\"Nimbus 13\" data-tags=\"budget\">\n        <div class=\"row between center\">\n          <h3 class=\"card-title\">Nimbus 13</h3>\n          <span class=\"badge badge-secondary\">Best value</span>\n        </div>\n        <p class=\"muted small\">Everything you need, for less</p>\n        <div class=\"stat-label\">Price</div>\n        <div class=\"stat-value\">$999</div>\n        <div class=\"stat-label\">Weight</div>\n        <div class=\"stat-value\">1.0 kg</div>\n        <div class=\"stat-label\">Battery</div>\n        <div class=\"stat-value\">22 h</div>\n        <div class=\"progress\"><div style=\"width:100%\"></div></div>\n        <p class=\"small muted\">Best for: students and light office work</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"card stack\">\n    <div class=\"stack gap-sm\">\n      <h2 class=\"card-title\">Full specification</h2>\n      <p class=\"card-desc\">Every spec side by side. The highlighted column is the leader in that row.</p>\n    </div>\n    <table>\n      <thead>\n        <tr>\n          <th>Spec</th>\n          <th data-col=\"Aero 14\">Aero 14</th>\n          <th data-col=\"Forge 16\">Forge 16</th>\n          <th data-col=\"Nimbus 13\">Nimbus 13</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"muted\">Tagline</td>\n          <td>Light, bright, long-lasting</td>\n          <td>Desktop power on the go</td>\n          <td>Everything you need, for less</td>\n        </tr>\n        <tr>\n          <td class=\"muted\">Price</td>\n          <td class=\"num\" data-best=\"low\">$1,299</td>\n          <td class=\"num\">$1,899</td>\n          <td class=\"num\" data-best=\"low\">$999</td>\n        </tr>\n        <tr>\n          <td class=\"muted\">Weight</td>\n          <td class=\"num\">1.2 kg</td>\n          <td class=\"num\">2.1 kg</td>\n          <td class=\"num\" data-best=\"low\">1.0 kg</td>\n        </tr>\n        <tr>\n          <td class=\"muted\">Battery life</td>\n          <td class=\"num\">18 h</td>\n          <td class=\"num\">9 h</td>\n          <td class=\"num\" data-best=\"high\">22 h</td>\n        </tr>\n        <tr>\n          <td class=\"muted\">Screen</td>\n          <td>14\" OLED</td>\n          <td>16\" IPS 165Hz</td>\n          <td>13\" IPS</td>\n        </tr>\n        <tr>\n         