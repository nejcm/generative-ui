ticle>\n  </section>\n\n  <section class=\"card stack gap-lg\">\n    <div class=\"row between center\">\n      <div>\n        <h2 class=\"card-title\">Side-by-side specifications</h2>\n        <p class=\"card-desc\">Scan the differences that matter most.</p>\n      </div>\n      <span class=\"badge badge-outline\" id=\"selectionBadge\">No selection</span>\n    </div>\n\n    <div class=\"stack gap-sm\" id=\"comparisonControls\">\n      <div class=\"row gap-lg\">\n        <label class=\"label\">Highlight a laptop\n          <select id=\"highlightSelect\">\n            <option value=\"Aero 14\">Aero 14</option>\n            <option value=\"Forge 16\">Forge 16</option>\n            <option value=\"Nimbus 13\">Nimbus 13</option>\n          </select>\n        </label>\n        <span class=\"small muted\" id=\"highlightHint\">Aero 14 is highlighted for travel and everyday work.</span>\n      </div>\n    </div>\n\n    <div class=\"table-wrap\">\n      <table class=\"table\" id=\"comparisonTable\">\n        <thead>\n          <tr>\n            <th>Specification</th>\n            <th data-column=\"Aero 14\">Aero 14</th>\n            <th data-column=\"Forge 16\">Forge 16</th>\n            <th data-column=\"Nimbus 13\">Nimbus 13</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><th>Tagline</th><td data-column=\"Aero 14\">Light, bright, long-lasting</td><td data-column=\"Forge 16\">Desktop power on the go</td><td data-column=\"Nimbus 13\">Everything you need, for less</td></tr>\n          <tr><th>Price</th><td class=\"num\" data-column=\"Aero 14\">$1,299</td><td class=\"num\" data-column=\"Forge 16\">$1,899</td><td class=\"num\" data-column=\"Nimbus 13\">$999</td></tr>\n          <tr><th>Weight</th><td class=\"num\" data-column=\"Aero 14\">1.2 kg</td><td class=\"num\" data-column=\"Forge 16\">2.1 kg</td><td class=\"num\" data-column=\"Nimbus 13\">1.0 kg</td></tr>\n          <tr><th>Battery life</th><td class=\"num\" data-column=\"Aero 14\">18 h</td><td class=\"num\" data-column=\"Forge 16\">9 h</td><td class=\"num\" data-column=\"Nimbus 13\">22 h</td></tr>\n          <tr><th>Display</th><td data-column=\"Aero 14\">14&quot; OLED</td><td data-column=\"Forge 16\">16&quot; IPS 165Hz</td><td data-column=\"Nimbus 13\">13&quot; IPS</td></tr>\n          <tr><th>Processor</th><td data-column=\"Aero 14\">8-core, 15 W</td><td data-column=\"Forge 16\">16-core, 55 W</td><td data-column=\"Nimbus 13\">6-core, 15 W</td></tr>\n          <tr><th>Memory</th><td class=\"num\" data-column=\"Aero 14\">16 GB</td><td class=\"num\" data-column=\"Forge 16\">32 GB</td><td class=\"num\" data-column=\"Nimbus 13\">16 GB</td></tr>\n          <tr><th>Storage</th><td class=\"num\" data-column=\"Aero 14\">512 GB</td><td class=\"num\" data-column=\"Forge 16\">1,024 GB</td><td class=\"num\" data-column=\"Nimbus 13\">256 GB</td></tr>\n          <tr><th>Ports</th><td data-column=\"Aero 14\">2× USB-C, HDMI, headphone</td><td data-column=\"Forge 16\">2× USB-C, 3× USB-A, HDMI, Ethernet, SD card</td><td data-column=\"Nimbus 13\">2× USB-C, headphone</td></tr>\n          <tr><th>Rating</th><td class=\"num\" data-column=\"Aero 14\">★ 4.6 <span class=\"muted\">(1,840)</span></td><td class=\"num\" data-column=\"Forge 16\">★ 4.4 <span class=\"muted\">(960)</span></td><td class=\"num\" data-column=\"Nimbus 13\">★ 4.2 <span class=\"muted\">(2,310)</span></td></tr>\n          <tr><th>Best for</th><td data-column=\"Aero 14\">Travel and everyday work</td><td data-column=\"Forge 16\">Video editing, 3D and gaming</td><td data-column=\"Nimbus 13\">Students and light office work</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"grid cols-2 gap-lg\">\n    <div class=\"card stack gap-sm\">\n      <h2 class=\"card-title\">Performance at a glance</h2>\n      <p class=\"card-desc\">Processor power compared by wattage.</p>\n      <div data-chart='{\"type\":\"bar\",\"title\":\"Processor power (W)\",\"data\":[{\"label\":\"Aero 14\",\"value\":15},{\"label\":\"Forge 16\",\"value\":55},{\"label\":\"Nimbus 13\",\"value\":15}]}'></div>\n    </div>\n    <div class=\"card stack gap-sm\">\n      <h2 class=\"card-title\">Battery life</h2>\n      <p class=\"card-desc\">Claimed hours of use.</p>\n      <div data-chart='{\"type\":\"bar\",\"title\":\"Battery life (hours)\",\"data\":[{\"label\":\"Aero 14\",\"value\":18},{\"label\":\"Forge 16\",\"value\":9},{\"label\":\"Nimbus 13\",\"value\":22}]}'></div>\n    </div>\n  </section>\n\n  <section class=\"card stack gap-lg\">\n    <div>\n      <h2 class=\"card-title\">Trade-offs</h2>\n      <p class=\"card-desc\">The clearest reasons to choose—or reconsider—each laptop.</p>\n    </div>\n    <div class=\"grid cols-3\">\n      <article class=\"stack gap-sm\" data-column=\"Aero 14\">\n        <h3>Aero 14</h3>\n        <div class=\"stack gap-sm\"><strong class=\"up\">Pros</strong><ul><li>Gorgeous OLED panel</li><li>Great battery</li><li>Quiet under load</li></ul></div>\n        <div class=\"stack gap-sm\"><strong class=\"down\">Cons</strong><ul><li>Soldered RAM</li><li>Glossy screen</li></ul></div>\n      </article>\n      <article class=\"stack gap-sm\" data-column=\"Forge 16\">\n        <h3>Forge 16</h3>\n        <div class=\"stack gap-sm\"><strong class=\"up\">Pros</strong><ul><li>Fastest of the three</li><li>Upgradeable RAM and SSD</li><li>Full port selection</li></ul></div>\n        <div class=\"stack gap-sm\"><strong class=\"down\">Cons</strong><ul><li>Heavy</li><li>Fans are audible</li></ul></div>\n      </article>\n      <article class=\"stack gap-sm\" data-column=\"Nimbus 13\">\n        <h3>Nimbus 13</h3>\n        <div class=\"stack gap-sm\"><strong class=\"up\">Pros</strong><ul><li>Lightest</li><li>Best battery life</li><li>Lowest price</li></ul></div>\n        <div class=\"stack gap-sm\"><strong class=\"down\">Cons</strong><ul><li>Dimmer screen</li><li>Small SSD</li></ul></div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"card stack gap-sm\" id=\"recommendation\" aria-live=\"polite\">\n    <h2 class=\"card-title\">Quick recommendation</h2>\n    <p class=\"lead\" id=\"recommendationText\">Choose <strong>Aero 14</strong> for the best balance of portability, battery life, display quality, and everyday performance.</p>\n    <p class=\"small muted\" id=\"recommendationDetail\">At 1.2 kg and 18 hours of claimed battery life, it is the strongest all-round choice for travel and daily work.</p>\n  </section>\n</div>\n\n<style>\n  .table-wrap{overflow-x:auto}\n  .table th:first-child{min-width:140px}\n  .table thead th:not(:first-child),.table td:not(:first-child){min-width:190px}\n  .table [data-column]{transition:background-color .18s ease,color .18s ease}\n  .table .is-highlighted,.trade-offs .is-highlighted{background:color-mix(in srgb,var(--accent) 10%,transparent)}\n  .trade-offs{grid-column:1/-1}\n  @media(max-width:700px){.table thead th:nth-child(4),.table td:nth-child(4){display:none}}\n</style>\n\n<script>\n  const laptops = {\n    'Aero 14': {\n      use: 'travel and everyday work',\n      reason: 'At 1.2 kg and 18 hours of claimed battery life, it is the strongest all-round choice for travel and daily work.'\n    },\n    'Forge 16': {\n      use: 'video editing, 3D and gaming',\n      reason: 'Its 16-core processor, 32 GB RAM, 1,024 GB SSD, and full port selection make it the clear performance choice.'\n    },\n    'Nimbus 13': {\n      use: 'students and light office work',\n      reason: 'At $999, 1.0 kg, and 22 hours of claimed battery life, it delivers the best value for lighter workloads.'\n    }\n  };\n\n  function highlight(name) {\n    document.querySelectorAll('[data-column]').forEach(el => {\n      el.classList.toggle('is-highlighted', el.dataset.column === name);\n    });\n    document.getElementById('highlightSelect').value = name;\n    document.getElementById('highlightHint').textContent = name + ' is highlighted for ' + laptops[name].use + '.';\n    document.getElementById('selectionBadge').textContent = name + ' selected';\n    document.getElementById('recommendationText').innerHTML = 'Choose <strong>' + name + '</strong> for ' + laptops[name].use + '.';\n    document.getElementById('recommendationDetail').textContent = laptops[name].reason;\n  }\n\n  document.getElementById('highlightSelect').addEventListener('change', e => highlight(e.target.value));\n  document.querySelectorAll('[data-pick]').forEach(button => {\n    button.addEventListener('click', () => {\n      highlight(button.dataset.pick);\n      document.getElementById('comparisonControls').scrollIntoView({behavior:'smooth', block:'center'});\n    });\n  });\n\n  function sortCards(key, label) {\n    const grid = document.querySelector('.grid.cols-3');\n    const cards = [...grid.querySelectorAll('article')];\n    cards.sort((a,b) => Number(a.dataset[key]) - Number(b.dataset[key]));\n    cards.forEach(card => grid.appendChild(card));\n    document.querySelectorAll('.row.gap-sm button').forEach(b => {\n      b.className = 'btn ' + (b.id === (key === 'price' ? 'sortPrice' : key === 'value' ? 'sortValue' : 'sortPower') ? '' : 'btn-ghost');\n    });\n    document.getElementById('sortPrice').textContent = key === 'price' ? 'Sorted: ' + label : 'Sort: Best match';\n    document.getElementById('sortValue').textContent = key === 'value' ? 'Sorted: ' + label : 'Best value';\n    document.getElementById('sortPower').textContent = key === 'power' ? 'Sorted: ' + label : 'Most powerful';\n  }\n\n  document.getElementById('sortPrice').addEventListener('click', () => sortCards('price', 'Price'));\n  document.getElementById('sortValue').addEventListener('click', () => sortCards('value', 'Value'));\n  document.getElementById('sortPower').addEventListener('click', () => sortCards('power', 'Power'));\n\n  highlight('Aero 14');\n</script>","deltas":[[20955,"<div class=\"page stack gap-lg\">\n  <header class=\"stack gap-sm\">\n    <div class=\"row between center gap-sm\">\n      <div class=\"stack gap-sm\"