n>\n        </div>\n        <p class=\"card-desc\">Light, bright, long-lasting</p>\n        <div class=\"stat-label\">Price</div>\n        <div class=\"stat-value\">$1,299</div>\n        <p class=\"small muted\">Best for travel and everyday work</p>\n      </div>\n\n      <div class=\"card stack gap-sm\">\n        <div class=\"row between center\">\n          <h3 class=\"card-title\">Forge 16</h3>\n          <span class=\"badge badge-outline\">Most powerful</span>\n        </div>\n        <p class=\"card-desc\">Desktop power on the go</p>\n        <div class=\"stat-label\">Price</div>\n        <div class=\"stat-value\">$1,899</div>\n        <p class=\"small muted\">Best for video editing, 3D and gaming</p>\n      </div>\n    </section>\n\n    <section class=\"stack gap-sm\">\n      <h2>Specifications</h2>\n      <p class=\"muted small\">The best value in each row is marked with <span class=\"up\">▲</span>. Where a lower number is better, the lowest is marked.</p>\n      <div class=\"card\">\n        <table class=\"table\">\n          <thead>\n            <tr>\n              <th>Spec</th>\n              <th>Aero 14</th>\n              <th>Forge 16</th>\n              <th>Nimbus 13</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>Price</td>\n              <td class=\"num\">$1,299</td>\n              <td class=\"num\">$1,899</td>\n              <td class=\"num up\">$999 ▲</td>\n            </tr>\n            <tr>\n              <td>Screen</td>\n              <td>14\" OLED</td>\n              <td class=\"up\">16\" IPS 165Hz ▲</td>\n              <td>13\" IPS</td>\n            </tr>\n            <tr>\n              <td>CPU</td>\n              <td>8-core, 15 W</td>\n              <td class=\"up\">16-core, 55 W ▲</td>\n              <td>6-core, 15 W</td>\n            </tr>\n            <tr>\n              <td>Memory (RAM)</td>\n              <td class=\"num\">16 GB</td>\n              <td class=\"num up\">32 GB ▲</td>\n              <td class=\"num\">16 GB</td>\n            </tr>\n            <tr>\n              <td>Storage</td>\n              <td class=\"num\">512 GB</td>\n              <td class=\"num up\">1024 GB ▲</td>\n              <td class=\"num\">256 GB</td>\n            </tr>\n            <tr>\n              <td>Weight</td>\n              <td class=\"num\">1.2 kg</td>\n              <td class=\"num\">2.1 kg</td>\n              <td class=\"num up\">1.0 kg ▲</td>\n            </tr>\n            <tr>\n              <td>Battery</td>\n              <td class=\"num\">18 h</td>\n              <td class=\"num\">9 h</td>\n              <td class=\"num up\">22 h ▲</td>\n            </tr>\n            <tr>\n              <td>Ports</td>\n              <td>2x USB-C, HDMI, headphone</td>\n              <td>2x USB-C, 3x USB-A, HDMI, Ethernet, SD card</td>\n              <td>2x USB-C, headphone</td>\n            </tr>\n            <tr>\n              <td>Rating</td>\n              <td class=\"num up\">4.6 ▲</td>\n              <td class=\"num\">4.4</td>\n              <td class=\"num\">4.2</td>\n            </tr>\n            <tr>\n              <td>Reviews</td>\n              <td class=\"num\">1,840</td>\n              <td class=\"num\">960</td>\n              <td class=\"num\">2,310</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"stack gap-sm\">\n      <h2>Value metrics</h2>\n      <p class=\"muted small\">Derived from the specs above. Lower cost per GB is better. Higher hours per kg is better.</p>\n      <div class=\"card\">\n        <table class=\"table\">\n          <thead>\n            <tr>\n              <th>Metric</th>\n              <th>Aero 14</th>\n              <th>Forge 16</th>\n              <th>Nimbus 13</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>Price vs Nimbus 13</td>\n              <td class=\"num up\">+30%</td>\n              <td class=\"num down\">+90%</td>\n              <td class=\"num\">Baseline</td>\n            </tr>\n            <tr>\n              <td>Cost per GB of storage</td>\n              <td class=\"num\">$2.54</td>\n              <td class=\"num up\">$1.85</td>\n              <td class=\"num down\">$3.90</td>\n            </tr>\n            <tr>\n              <td>Cost per GB of RAM</td>\n              <td class=\"num down\">$81.19</td>\n              <td class=\"num up\">$59.34</td>\n              <td class=\"num\">$62.44</td>\n            </tr>\n            <tr>\n              <td>Battery hours per kg</td>\n              <td class=\"num\">15.0 h/kg</td>\n              <td class=\"num down\">4.3 h/kg</td>\n              <td class=\"num up\">22.0 h/kg</td>\n            </tr>\n            <tr>\n              <td>Physical ports</td>\n              <td class=\"num\">4</td>\n              <td class=\"num up\">8</td>\n              <td class=\"num\">3</td>\n            </tr>\n            <tr>\n              <td>Share of total reviews</td>\n              <td class=\"num\">36.0%</td>\n              <td class=\"num\">18.8%</td>\n              <td class=\"num\">45.2%</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"stack gap-sm\">\n      <h2>Charts</h2>\n      <div class=\"grid cols-2\">\n        <div class=\"card\">\n          <div data-chart='{\"type\":\"bar\",\"title\":\"Price (USD)\",\"data\":[{\"label\":\"Nimbus 13\",\"value\":999},{\"label\":\"Aero 14\",\"value\":1299},{\"label\":\"Forge 16\",\"value\":1899}]}'></div>\n        </div>\n        <div class=\"card\">\n          <div data-chart='{\"type\":\"bar\",\"title\":\"Battery life (hours)\",\"data\":[{\"label\":\"Nimbus 13\",\"value\":22},{\"label\":\"Aero 14\",\"value\":18},{\"label\":\"Forge 16\",\"value\":9}]}'></div>\n        </div>\n        <div class=\"card\">\n          <div data-chart='{\"type\":\"pie\",\"title\":\"Share of total reviews (5,110)\",\"data\":[{\"label\":\"Nimbus 13\",\"value\":2310},{\"label\":\"Aero 14\",\"value\":1840},{\"label\":\"Forge 16\",\"value\":960}]}'></div>\n        </div>\n        <div class=\"card\">\n          <div data-chart='{\"type\":\"bar\",\"title\":\"Storage (GB)\",\"data\":[{\"label\":\"Nimbus 13\",\"value\":256},{\"label\":\"Aero 14\",\"value\":512},{\"label\":\"Forge 16\",\"value\":1024}]}'></div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"stack gap-sm\">\n      <h2>Pros and cons</h2>\n      <div class=\"grid cols-3\">\n        <div class=\"card stack gap-sm\">\n          <h3 class=\"card-title\">Aero 14</h3>\n          <p class=\"small\"><span class=\"up\">Pros:</span> Gorgeous OLED panel, great battery, quiet under load</p>\n          <p class=\"small\"><span class=\"down\">Cons:</span> Soldered RAM, glossy screen</p>\n        </div>\n        <div class=\"card stack gap-sm\">\n          <h3 class=\"card-title\">Forge 16</h3>\n          <p class=\"small\"><span class=\"up\">Pros:</span> Fastest of the three, upgradeable RAM and SSD, full port selection</p>\n          <p class=\"small\"><span class=\"down\">Cons:</span> Heavy, fans are audible</p>\n        </div>\n        <div class=\"card stack gap-sm\">\n          <h3 class=\"card-title\">Nimbus 13</h3>\n          <p class=\"small\"><span class=\"up\">Pros:</span> Lightest, best battery life, lowest price</p>\n          <p class=\"small\"><span class=\"down\">Cons:</span> Dimmer screen, small SSD</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"stack gap-sm\">\n      <h2>Which one to pick</h2>\n      <div class=\"grid cols-3\">\n        <div class=\"card stack gap-sm\">\n          <span class=\"badge badge-secondary\">Tight budget</span>\n          <h3 class=\"card-title\">Choose Nimbus 13</h3>\n          <p class=\"card-desc\">It costs $300 less than the Aero 14 and has the longest battery life and lightest weight. The 256 GB storage and dimmer screen are the trade-offs.</p>\n          <button class=\"btn btn-outline btn-sm\">Compare Nimbus 13 in detail</button>\n        </div>\n        <div class=\"card stack gap-sm\">\n          <span class=\"badge\">Best all-rounder</span>\n          <h3 class=\"card-title\">Choose Aero 14</h3>\n          <p class=\"card-desc\">It has the highest rating (4.6) and the best screen, with 512 GB storage and 18 hours of battery at 1.2 kg. Soldered RAM means 16 GB is what you get for life.</p>\n          <button class=\"btn btn-outline btn-sm\">Compare Aero 14 in detail</button>\n        </div>\n        <div class=\"card stack gap-sm\">\n          <span class=\"badge badge-outline\">Heavy workloads</span>\n          <h3 class=\"card-title\">Choose Forge 16</h3>\n          <p class=\"card-desc\">It is the fastest, with 32 GB RAM, 1 TB storage and the most ports, and you can upgrade the RAM and SSD later. Expect 9 hours of battery, a 2.1 kg weight and audible fans.</p>\n          <button class=\"btn btn-outline btn-sm\">Compare Forge 16 in detail</button>\n        </div>\n      </div>\n    </section>\n\n  </div>\n</div>","deltas":[[7406,"<div class=\"page\">"],[7422,"\n  "],[7443,"<div class=\"stack g"],[7464,"ap-lg\">\n\n    <"],[7484,"header"],[7504," class"],[7525,"=\"stack g"],[7544,"ap-sm\">\n      <"],[7564,"h1>Laptop com"],[7584,"parison: Aero 14"],[7607,", Forge 16 "],[7627,"and Nimbus 13"],[7646,"</h1>\n      <p"],[7667," class=\"lead\">Three"],[7689," laptops at"],[7711," different points"],[7729," on"],[7749," price and"],[7773," performance. Compare spec"],[7790,"s, derived value"],[7810," fig"],[7830,"ures and"],[7851," p"],[7874,"ros and cons,"],[7892," then use"],[7915," the pic"],[7934,"ks at the b"],[7954,"ottom to choose."],[7974,"</p>\n      <p class"],[7995,"=\"muted small"],[8017,"\">"],[8034,"Ratings and review counts are as"],[8056," of"],[8075," 25"],[8096," October 2026. Der"],[8116,"ived figures are"],[8138," calculated from the list"],[8171,"ed spec"],[8182,"s.</p>\n    </"],[8198,"header>\n\n   