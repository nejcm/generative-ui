 request names, with no extra pages or marketing sections.\n- Use the supplied DATA in full: every field is there to be shown. Derive useful extras from it (shares, totals, deltas, rankings) instead of inventing unrelated numbers.\n- Where it fits, add status badges, trend/change figures, secondary actions, helper text, and sensible empty or edge-case copy.\n- Establish hierarchy with headings, size and weight; group related items; keep spacing and alignment consistent.\n- Make charts readable: a title, labelled axes or values, and a legend for pie charts.\n- Never use lorem ipsum or placeholder names like \"Item 1\".","systemHash":"0c16911c9564c3db3ada7a622931ee6ffc820ebf9a373996782a9f1f0fc3c98c","systemOverridden":false,"strictOutput":false,"rawOutput":"<main class=\"page stack\">\n  <section class=\"card stack\" aria-labelledby=\"profile-name\">\n    <div class=\"row between gap-sm\">\n      <div class=\"row gap-sm\">\n        <div class=\"avatar center\" aria-label=\"Avatar for Maya Chen\">MC</div>\n        <div class=\"stack gap-sm\">\n          <h1 class=\"h2\" id=\"profile-name\">Maya Chen</h1>\n          <p class=\"muted\">Product Designer · Northstar Studio</p>\n        </div>\n      </div>\n      <span class=\"badge badge-secondary\">Available for projects</span>\n    </div>\n\n    <p class=\"lead\">Designing thoughtful digital experiences, with a focus on accessibility and the small details that make products feel intuitive.</p>\n\n    <div class=\"grid cols-3\" aria-label=\"Profile statistics\">\n      <div class=\"stack gap-sm\">\n        <span class=\"stat-value\">24</span>\n        <span class=\"stat-label\">Projects</span>\n      </div>\n      <div class=\"stack gap-sm\">\n        <span class=\"stat-value\">1.8k</span>\n        <span class=\"stat-label\">Followers</span>\n      </div>\n      <div class=\"stack gap-sm\">\n        <span class=\"stat-value\">640</span>\n        <span class=\"stat-label\">Following</span>\n      </div>\n    </div>\n\n    <div class=\"row gap-sm\">\n      <button class=\"btn btn-block\" id=\"follow-button\" type=\"button\" aria-pressed=\"false\">Follow</button>\n      <button class=\"btn btn-outline\" type=\"button\" aria-label=\"More profile options\">More</button>\n    </div>\n  </section>\n</main>\n\n<script>\n  const followButton = document.getElementById(\"follow-button\");\n  followButton.addEventListener(\"click\", () => {\n    const isFollowing = followButton.getAttribute(\"aria-pressed\") === \"true\";\n    followButton.setAttribute(\"aria-pressed\", String(!isFollowing));\n    followButton.textContent = isFollowing ? \"Follow\" : \"Following\";\n    followButton.classList.toggle(\"btn-outline\", !isFollowing);\n  });\n</script>","deltas":[[3548,"<"],[3548,"main"],[3548," class"],[3548,"=\""],[3548,"page"],[3549," stack"],[3549,"\">\n"],[3549," "],[3549," <"],[3549,"section"],[3549," class"],[3550,"=\""],[3550,"card"],[3550," stack"],[3552,"\""],[3556," aria"],[3560,"-labelledby"],[3567,"=\""],[3570,"profile"],[3573,"-name"],[3577,"\">\n"],[3580,"   "],[3584," <"],[3588,"div"],[3591," class"],[3597,"=\""],[3603,"row"],[3607," between"],[3611," gap"],[3615,"-sm"],[3620,"\">\n"],[3624,"     "],[3632," <"],[3636,"div"],[3637," class"],[3641,"=\""],[3644,"row"],[3650," gap"],[3652,"-sm"],[3655,"\">\n"],[3657,"       "],[3665," <"],[3668,"div"],[3671," class"],[3680,"=\""],[3683,"avatar"],[3686," center"],[3692,"\""],[3697," aria"],[3699,"-label"],[3830,"=\""],[3830,"Avatar"],[3830," for"],[3830," Maya"],[3830," Chen"],[3830,"\">"],[3836,"MC"],[3836,"</"],[3836,"div"],[3836,">\n"],[3836,"       "],[3836," <"],[3836,"div"],[3836," class"],[3837,"=\""],[3837,"stack"],[3837," gap"],[3837,"-sm"],[3837,"\">\n"],[3837,"         "],[3837," <"],[3837,"h"],[3837,"1"],[3837," class"],[3841,"=\""],[3841,"h"],[3841,"2"],[3841,"\""],[3841," id"],[3841,"=\""],[3842,"profile"],[3842,"-name"],[3842,"\">"],[3842,"M"],[3842,"aya"],[3842," Chen"],[3846,"</"],[3847,"h"],[3854,"1"],[3858,">\n"],[386