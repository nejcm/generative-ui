tter-spacing: -.02em; }\n  .links a { margin-right: 1rem; }\n  @media (max-width: 640px) {\n    .name { font-size: 2.3rem; }\n    .proj { grid-template-columns: 1fr; gap: .4rem; }\n    .stats { grid-template-columns: 1fr; }\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n\n  <header class=\"hero\">\n    <p class=\"eyebrow\">Portfolio · Ljubljana, Slovenia</p>\n    <h1 class=\"name\">Mira Kovač</h1>\n    <p class=\"role-line\">Product designer</p>\n    <p class=\"bio\">I design calm, usable software for public services and small teams. Ten years across research, interaction design and front-end prototyping.</p>\n    <div class=\"row gap-lg\" style=\"margin-top:1.4rem; flex-wrap:wrap;\">\n      <a class=\"btn\" href=\"mailto:mira@example.com\">Email Mira</a>\n      <span class=\"badge badge-outline\">Open to freelance work from January</span>\n    </div>\n  </header>\n\n  <section class=\"stack\" style=\"margin-top:2.5rem;\">\n    <h2 class=\"stat-label\">At a glance</h2>\n    <div class=\"stats\">\n      <div class=\"stat\">\n        <div class=\"stat-value\">10</div>\n        <div class=\"stat-label\">Years designing</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-value\">24</div>\n        <div class=\"stat-label\">Products shipped</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-value\">1.2M</div>\n        <div class=\"stat-label\">People reached</div>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section>\n    <h2>Selected projects</h2>\n    <p class=\"muted small\">Public-sector and service work, 2024–2026.</p>\n\n    <article class=\"proj\">\n      <div class=\"proj-meta\">\n        <span class=\"proj-year\">2026</span>\n        Lead designer\n      </div>\n      <div>\n        <h3>Transit app redesign</h3>\n        <p class=\"proj-client\">Ljubljana Public Transport · <span class=\"badge badge-secondary\" style=\"font-size:.68rem;\">mobile</span> <span class=\"badge badge-secondary\" style=\"font-size:.68rem;\">research</span></p>\n        <p class=\"proj-summary\">Cut trip-planning taps from 7 to 3 for 400k riders.</p>\n        <p class=\"outcome\"><span class=\"arrow\">→</span> <span>App store rating rose from 3.4 to 4.6 in six months.</span></p>\n      </div>\n    </article>\n\n    <article class=\"proj\">\n      <div class=\"proj-meta\">\n        <span class=\"proj-year\">2025</span>\n        Product designer\n      </div>\n      <div>\n        <h3>Clinic booking system</h3>\n        <p class=\"proj-client\">Zdravje Clinics · <span class=\"badge badge-secondary\" style=\"font-size:.68rem;\">web</span> <span class=\"badge badge-secondary\" style=\"font-size:.68rem;\">service design</span></p>\n        <p class=\"proj-summary\">Self-serve booking that halved front-desk calls.</p>\n        <p class=\"outcome\"><span class=\"arrow\">→</span> <span>58% fewer booking calls; 91% of patients book online.</span></p>\n      </div>\n    </article>\n\n    <article class=\"proj\">\n      <div class=\"proj-meta\">\n        <span class=\"proj-year\">2024</span>\n        Design and front-end\n      </div>\n      <div>\n        <h3>Open data dashboard</h3>\n        <p class=\"proj-client\">City of Ljubljana · <span class=\"badge badge-secondary\" style=\"font-size:.68rem;\">data viz</span></p>\n        <p class=\"proj-summary\">City budget explorer used by 30k residents.</p>\n        <p class=\"outcome\"><span class=\"arrow\">→</span> <span>Featured by two national newspapers; open-sourced.</span></p>\n      </div>\n    </article>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section>\n    <h2>Capabilities</h2>\n    <ul class=\"skill-list\">\n      <li>Interaction design</li>\n      <li>User research</li>\n      <li>Design systems</li>\n      <li>Prototyping</li>\n      <li>Service design</li>\n    </ul>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section>\n    <h2>What clients say</h2>\n    <blockquote class=\"quote\">“Mira turned a tangle of requirements into something our riders actually enjoy using.”</blockquote>\n    <p class=\"quote-by\"><strong>Tina Zupan</strong> — Head of Digital, LPP</p>\n  </section>\n\n  <hr class=\"rule\">\n\n  <footer class=\"between\" style=\"flex-wrap:wrap; gap:1rem;\">\n    <div class=\"links\">\n      <a href=\"#\" class=\"btn btn-outline btn-sm\">Dribbble</a>\n      <a href=\"#\" class=\"btn btn-outline btn-sm\">LinkedIn</a>\n      <a href=\"#\" class=\"btn btn-outline btn-sm\">Read.cv</a>\n    </div>\n    <p class=\"muted small\" style=\"margin:0;\">mira@example.com · Available from January</p>\n  </footer>\n\n</main>\n</body>\n</html>","deltas":[[2283,"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale"],[2401,"=1.0\">\n<title>M"],[2620,"ira Kovač — Product Designer</title>\n<style>\n  :root {\n    --accent: #2f5d50;\n    --accent-soft: #e7f0ec;\n    --ink: #16211d;\n "],[2748," }\n  body { font"],[2915,"-family: \"Georgia\", \"Iowan Old Style\", serif;"],[3076," }\n  h1, h2, h3, .stat-value, .badge { font-family: -apple-system, Blink"],[3186,"MacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif; }\n  .page { max-width: 900px"],[3323,"; }\n  .hero { border-bottom: 1px solid var(--ink); padding-bottom: 2rem; }\n  .ey"],[3447,"ebrow { letter-spacing: .18em; text-transform: uppercase; font-size: .72rem; font-family: -"],[3577,"apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif; color: var(--accent); }\n  .name {"],[3689," font-size: 3.2rem; line-height: 1.05"],[3897,"; margin: .2rem 0 .1rem; letter-spacing: -.02em; }\n  .role-line { font-size: 1.05rem; color: var(--accent); }\n  .bio { max-width: 56ch; font-size: 1.12rem; line-height: 1"],[4166,".65; color: #33413b; }\n  .rule { border: 0; border-top: 1px solid #d9d5cc; margin: 2.5rem 0; }\n  .proj"],[4426," { display: grid; grid-template-columns: 150px 1fr; gap: 1.5rem; padding: 1.6rem 0; border-top: 1px soli