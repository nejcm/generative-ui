pan class=\"stat-value\">142</span>\n          </div>\n          <div class=\"stack gap-sm\">\n            <span class=\"stat-label\">Followers</span>\n            <span class=\"stat-value\" id=\"follower-count\">3,218</span>\n          </div>\n          <div class=\"stack gap-sm\">\n            <span class=\"stat-label\">Following</span>\n            <span class=\"stat-value\">286</span>\n          </div>\n          <div class=\"stack gap-sm\">\n            <span class=\"stat-label\">Likes</span>\n            <span class=\"stat-value\">11.4k</span>\n          </div>\n        </div>\n\n        <hr class=\"hr\">\n\n        <div class=\"row between\">\n          <div class=\"row gap-sm\">\n            <span class=\"badge-secondary badge\">🎨 Design</span>\n            <span class=\"badge-secondary badge\">♿ Accessibility</span>\n            <span class=\"badge-secondary badge\">🧩 Systems</span>\n          </div>\n          <button class=\"btn btn-lg\" id=\"follow-btn\" onclick=\"toggleFollow()\">Follow</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nlet following = false;\nfunction toggleFollow() {\n  const btn = document.getElementById('follow-btn');\n  const count = document.getElementById('follower-count');\n  let num = parseInt(count.textContent.replace(/,/g, ''));\n  following = !following;\n  if (following) {\n    btn.textContent = 'Following';\n    btn.classList.add('btn-secondary');\n    btn.classList.remove('btn-lg');\n    btn.classList.add('btn-lg');\n    num += 1;\n  } else {\n    btn.textContent = 'Follow';\n    btn.classList.remove('btn-secondary');\n    num -= 1;\n  }\n  count.textContent = num.toLocaleString();\n}\n</script>","deltas":[[5432,"<div class"],[5433,"=\"page"],[5522,"\">\n  <"],[5533,"div class=\"stack"],[5700," gap-lg\">\n"],[5715,"   "],[5774," <div class=\""],[5785,"card\">"],[5844,"\n      <div"],[5855," class=\"stack"],[5878," gap-lg\">\n"],[5887,"        <"],[5986,"div class=\"row"],[6020," between\">\n