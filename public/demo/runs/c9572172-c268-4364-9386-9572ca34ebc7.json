ero 14\",\"value\":512},{\"label\":\"Forge 16\",\"value\":1024},{\"label\":\"Nimbus 13\",\"value\":256}]}'></div>\n    </div>\n  </section>\n\n  <section class=\"stack gap-sm\" id=\"specs\">\n    <div class=\"row between center gap-sm\">\n      <div>\n        <h2>Side-by-side specifications</h2>\n        <p class=\"muted small\">Badges mark the strongest value in each row. Uncheck to read the raw figures.</p>\n      </div>\n      <label class=\"check\"><input type=\"checkbox\" id=\"winnerToggle\" checked> Highlight winners</label>\n    </div>\n\n    <div class=\"table-scroll\">\n      <table id=\"specTable\">\n        <thead>\n          <tr>\n            <th scope=\"col\">Specification</th>\n            <th scope=\"col\">Aero 14</th>\n            <th scope=\"col\">Forge 16</th>\n            <th scope=\"col\">Nimbus 13</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th scope=\"row\">Price</th>\n            <td class=\"num\">$1,299</td>\n            <td class=\"num\">$1,899</td>\n            <td class=\"num\">$999 <span class=\"winner badge badge-secondary\">Lowest</span></td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Price vs Nimbus 13</th>\n            <td class=\"num\">+$300</td>\n            <td class=\"num\">+$900</td>\n            <td class=\"num\">—</td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Weight</th>\n            <td class=\"num\">1.2 kg</td>\n            <td class=\"num\">2.1 kg</td>\n            <td class=\"num\">1.0 kg <span class=\"winner badge badge-secondary\">Lightest</span></td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Battery life</th>\n            <td class=\"num\">18 h</td>\n            <td class=\"num\">9 h</td>\n            <td class=\"num\">22 h <span class=\"winner badge badge-secondary\">Longest</span></td>\n          </tr>\n          <tr>\n            <th scope=\"row\">Screen</th>\n            <td class=\"num\">14\" OLED <span class=