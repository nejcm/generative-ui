obile\",\n        \"research\"\n      ]\n    },\n    {\n      \"title\": \"Clinic booking system\",\n      \"year\": 2025,\n      \"role\": \"Product designer\",\n      \"client\": \"Zdravje Clinics\",\n      \"summary\": \"Self-serve booking that halved front-desk calls.\",\n      \"outcome\": \"58% fewer booking calls; 91% of patients book online.\",\n      \"tags\": [\n        \"web\",\n        \"service design\"\n      ]\n    },\n    {\n      \"title\": \"Open data dashboard\",\n      \"year\": 2024,\n      \"role\": \"Design and front-end\",\n      \"client\": \"City of Ljubljana\",\n      \"summary\": \"City budget explorer used by 30k residents.\",\n      \"outcome\": \"Featured by two national newspapers; open-sourced.\",\n      \"tags\": [\n        \"data viz\"\n      ]\n    }\n  ],\n  \"testimonial\": {\n    \"quote\": \"Mira turned a tangle of requirements into something our riders actually enjoy using.\",\n    \"author\": \"Tina Zupan\",\n    \"role\": \"Head of Digital, LPP\"\n  }\n}","systemHash":"7f7b03405c279f095db892fdd24437dfc241ff3c8abb65e91da9e557823238ce","systemOverridden":false,"strictOutput":false,"rawOutput":"\n\n<div class=\"page\">\n  <style>\n    .hero-avatar { width: 88px; height: 88px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #a855f7); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; color: #fff; font-weight: 700; margin: 0 auto 1.25rem; }\n    .hero-links a { color: inherit; text-decoration: none; opacity: .75; transition: opacity .15s; }\n    .hero-links a:hover { opacity: 1; }\n    .project-card { position: relative; }\n    .project-card .card-title { margin-bottom: .25rem; }\n    .project-meta { display: flex; gap: .5rem; align-items: center; margin-bottom: .75rem; flex-wrap: wrap; }\n    .project-summary { font-size: .95rem; line-height: 1.55; margin-bottom: .75rem; }\n    .project-outcome { font-size: .875rem; padding: .6rem .75rem; border-radius: .5rem; background: rgba(99,1