card\" style=\"padding:1.75rem;\">\n        <div class=\"project-meta\">\n          <span class=\"badge badge-secondary\">2025</span>\n          <span class=\"badge badge-outline\">Product</span>\n        </div>\n        <h3 class=\"card-title\" style=\"font-size:1.25rem;\">Clinic booking system</h3>\n        <p class=\"muted small\" style=\"margin-bottom:.75rem;\">Product designer · Zdravje Clinics</p>\n        <p class=\"project-summary\">Self-serve booking that halved front-desk calls.</p>\n        <div class=\"project-outcome\">58% fewer booking calls; 91% of patients book online.</div>\n        <div style=\"display:flex; gap:.4rem;\">\n          <span class=\"badge badge-outline\">web</span>\n          <span class=\"badge badge-outline\">service design</span>\n        </div>\n      </div>\n\n      <!-- Project 3 -->\n      <div class=\"card project-card\" style=\"padding:1.75rem;\">\n        <div class=\"project-meta\">\n          <span class=\"badge badge-secondary\">2024</span>\n          <span class=\"badge badge-outline\">Open source</span>\n        </div>\n        <h3 class=\"card-title\" style=\"font-size:1.25rem;\">Open data dashboard</h3>\n        <p class=\"muted small\" style=\"margin-bottom:.75rem;\">Design and front-end · City of Ljubljana</p>\n        <p class=\"project-summary\">City budget explorer used by 30k residents.</p>\n        <div class=\"project-outcome\">Featured by two national newspapers; open-sourced.</div>\n        <div style=\"display:flex; gap:.4rem;\">\n          <span class=\"badge badge-outline\">data viz</span>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- Testimonial -->\n  <section class=\"card\" style=\"max-width:700px; margin:0 auto 3rem; background:linear-gradient(135deg, rgba(99,102,241,.05), rgba(168,85,247,.05));\">\n    <div class=\"testimonial-block\">\n      Mira turned a tangle of requirements into something our riders actually enjoy using.\n      <div style=\"margin-top:1rem; font-style:norma