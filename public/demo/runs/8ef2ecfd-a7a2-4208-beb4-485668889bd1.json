ding:1.5rem;\">\n        <div class=\"stat-value\" style=\"font-size:2rem;\">10</div>\n        <div class=\"stat-label\">Years designing</div>\n      </div>\n      <div class=\"card center stack gap-sm\" style=\"padding:1.5rem;\">\n        <div class=\"stat-value\" style=\"font-size:2rem;\">24</div>\n        <div class=\"stat-label\">Products shipped</div>\n      </div>\n      <div class=\"card center stack gap-sm\" style=\"padding:1.5rem;\">\n        <div class=\"stat-value\" style=\"font-size:2rem;\">1.2M</div>\n        <div class=\"stat-label\">People reached</div>\n      </div>\n    </div>\n\n    <!-- Skills -->\n    <div id=\"about\" class=\"stack gap-sm\" style=\"padding-top:1rem;\">\n      <h3>Focus areas</h3>\n      <div class=\"row gap-sm\" style=\"flex-wrap:wrap;\">\n        <span class=\"badge\">Interaction design</span>\n        <span class=\"badge\">User research</span>\n        <span class=\"badge\">Design systems</span>\n        <span class=\"badge\">Prototyping</span>\n        <span class=\"badge\">Service design</span>\n      </div>\n    </div>\n\n    <div class=\"hr\"></div>\n\n    <!-- Projects -->\n    <div id=\"projects\" class=\"stack gap-lg\">\n      <div class=\"row between center\">\n        <h2>Selected projects</h2>\n        <div class=\"row gap-sm\" style=\"flex-wrap:wrap;\">\n          <button class=\"btn btn-sm btn-ghost filter-btn filter-active\" data-filter=\"all\">All</button>\n          <button class=\"btn btn-sm btn-ghost filter-btn\" data-filter=\"mobile\">Mobile</button>\n          <button class=\"btn btn-sm btn-ghost filter-btn\" data-filter=\"research\">Research</button>\n          <button class=\"btn btn-sm btn-ghost filter-btn\" data-filter=\"web\">Web</button>\n          <button class=\"btn btn-sm btn-ghost filter-btn\" data-filter=\"service design\">Service design</button>\n          <button class=\"btn btn-sm btn-ghost filter-btn\" data-filter=\"data viz\">Data viz</button>\n        </div>\n      </div>\n\n      <div class