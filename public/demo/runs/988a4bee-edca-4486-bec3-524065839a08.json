size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }\n  .stat-grid .stat-value { font-size: 2.1rem; margin-top: 4px; }\n  .delta { font-size: 0.82rem; font-weight: 600; margin-top: 6px; }\n  .delta.up { color: var(--green, #16a34a); }\n  .delta.down { color: var(--red, #dc2626); }\n  .stock-in { background: color-mix(in srgb, #16a34a 14%, transparent); color: #16a34a; }\n  .stock-low { background: color-mix(in srgb, #eab308 18%, transparent); color: #a16207; }\n  .stock-out { background: color-mix(in srgb, #dc2626 14%, transparent); color: #dc2626; }\n  .status-shipped { background: color-mix(in srgb, #3b82f6 14%, transparent); color: #2563eb; }\n  .status-processing { background: color-mix(in srgb, #a16207 14%, transparent); color: #a16207; }\n  .status-delivered { background: color-mix(in srgb, #16a34a 14%, transparent); color: #16a34a; }\n  .card-title-row { display: flex; justify-content: space-between; align-items: center; }\n  .toggle-group { display: flex; gap: 4px; }\n  .toggle-btn { padding: 4px 14px; font-size: 0.78rem; border-radius: 6px; border: 1px solid var(--border, #e5e7eb); background: transparent; cursor: pointer; color: var(--text-muted, #6b7280); transition: all 120ms; }\n  .toggle-btn.active { background: var(--accent, #3b82f6); color: #fff; border-color: var(--accent, #3b82f6); }\n  .toggle-btn:hover:not(.active) { background: color-mix(in srgb, var(--accent, #3b82f6) 8%, transparent); }\n  .channel-detail { width: 100%; }\n  .growth-cell { font-weight: 600; }\n</style>\n\n<div class=\"page dashboard\">\n\n  <!-- ── Header ── -->\n  <div class=\"stack gap-sm\">\n    <div class=\"header-row\" style=\"align-items:center;gap:14px;\">\n      <h1>Q3 2026 Performance</h1>\n      <span class=\"period-tag\">2026-Q3</span>\n    </div>\n    <p class=\"muted\">Quarter-over-quarter analytics across revenue, channels and top products. All figures in EUR.</p>\n  </div>\n\n  <!-- ── Headline Stats ── -->\n  <div class=\"grid cols-4 stat-grid\">