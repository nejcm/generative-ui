at the request names, with no extra pages or marketing sections.\n- Use the supplied DATA in full: every field is there to be shown. Derive useful extras from it (shares, totals, deltas, rankings) instead of inventing unrelated numbers.\n- Where it fits, add status badges, trend/change figures, secondary actions, helper text, and sensible empty or edge-case copy.\n- Establish hierarchy with headings, size and weight; group related items; keep spacing and alignment consistent.\n- Make charts readable: a title, labelled axes or values, and a legend for pie charts.\n- Never use lorem ipsum or placeholder names like \"Item 1\".\n\nDATA (build the UI around this content):\n[\n  {\n    \"id\": 1041,\n    \"customer\": \"Ada Lovelace\",\n    \"email\": \"ada@example.com\",\n    \"status\": \"paid\",\n    \"amount\": 240,\n    \"date\": \"2026-10-02\",\n    \"items\": 3,\n    \"method\": \"Card\"\n  },\n  {\n    \"id\": 1042,\n    \"customer\": \"Linus Torvalds\",\n    \"email\": \"linus@example.com\",\n    \"status\": \"pending\",\n    \"amount\": 89.5,\n    \"date\": \"2026-10-03\",\n    \"items\": 1,\n    \"method\": \"Bank transfer\"\n  },\n  {\n    \"id\": 1043,\n    \"customer\": \"Grace Hopper\",\n    \"email\": \"grace@example.com\",\n    \"status\": \"refunded\",\n    \"amount\": 120,\n    \"date\": \"2026-10-05\",\n    \"items\": 2,\n    \"method\": \"Card\"\n  },\n  {\n    \"id\": 1044,\n    \"customer\": \"Alan Turing\",\n    \"email\": \"alan@example.com\",\n    \"status\": \"paid\",\n    \"amount\": 310.25,\n    \"date\": \"2026-10-08\",\n    \"items\": 4,\n    \"method\": \"PayPal\"\n  },\n  {\n    \"id\": 1045,\n    \"customer\": \"Margaret Hamilton\",\n    \"email\": \"margaret@example.com\",\n    \"status\": \"paid\",\n    \"amount\": 64,\n    \"date\": \"2026-10-11\",\n    \"items\": 1,\n    \"method\": \"Card\"\n  },\n  {\n    \"id\": 1046,\n    \"customer\": \"Ken Thompson\",\n    \"email\": \"ken@example.com\",\n    \"status\": \"pending\",\n    \"amount\": 199.99,\n    \"date\": \"2026-10-14\",\n    \"items\": 2,\n    \"method\": \"Bank transfer\"\n  },\n  {\n    \"id\": 1047,\n    \"customer\": \"Barbara Liskov\",\n    \"email\": \"barbara@example.com\",\n    \"status\": \"paid\",\n    \"amount\": 455,\n    \"date\": \"2026-10-15\",\n    \"items\": 5,\n    \"method\": \"Card\"\n  },\n  {\n    \"id\": 1048,\n    \"customer\": \"Dennis Ritchie\",\n    \"email\": \"dennis@example.com\",\n    \"status\": \"failed\",\n    \"amount\": 72.4,\n    \"date\": \"2026-10-17\",\n    \"items\": 1,\n    \"method\": \"Card\"\n  },\n  {\n    \"id\": 1049,\n    \"customer\": \"Radia Perlman\",\n    \"email\": \"radia@example.com\",\n    \"status\": \"paid\",\n    \"amount\": 138,\n    \"date\": \"2026-10-19\",\n    \"items\": 2,\n    \"method\": \"PayPal\"\n  },\n  {\n    \"id\": 1050,\n    \"customer\": \"Donald Knuth\",\n    \"email\": \"donald@example.com\",\n    \"status\": \"pending\",\n    \"amount\": 520.75,\n    \"date\": \"2026-10-21\",\n    \"items\": 6,\n    \"method\": \"Bank transfer\"\n  }\n]","systemHash":"900dc62241e47f39b9f17ed0cd0dce8cfffdb40dc34d8ba8f79d55034d16b6d4","systemOverridden":false,"strictOutput":false,"rawOutput":"<div class=\"page stack gap-lg\">\n  <div class=\"stack gap-sm\">\n    <h1>Orders</h1>\n    <p class=\"lead\">Ten orders placed between 2 and 21 October 2026. Search by customer, email or order ID, and narrow the list by payment status.</p>\n  </div>\n\n  <div class=\"grid cols-4\">\n    <div class=\"card\">\n      <div class=\"stat-label\">Total orders</div>\n      <div class=\"stat-value\">10</div>\n      <div class=\"small muted\">1,810.89 in gross value</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"stat-label\">Paid</div>\n      <div class=\"stat-value\">5</div>\n      <div class=\"small muted\">1,207.25 collected</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"stat-label\">Pending</div>\n      <div class=\"stat-value\">3</div>\n      <div class=\"small muted\">810.24 awaiting settlement</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"stat-label\">Refunded &amp; failed</div>\n      <div class=\"stat-value\">2</div>\n      <div class=\"small muted\">192.40 released or lost</div>\n    </div>\n  </div>\n\n  <div class=\"card stack gap-sm\">\n    <div class=\"row between center gap-sm\">\n      <div class=\"stack gap-sm\" style=\"flex:1 1 320px\">\n        <label class=\"stack gap-sm\" for=\"order-search\">Search</label>\n        <input id=\"order-search\" type=\"search\" placeholder=\"Search customer, email or ID…\" autocomplete=\"off\">\n      </div>\n      <div class=\"stack gap-sm\" style=\"flex:0 0 220px\">\n        <label class=\"stack gap-sm\" for=\"status-filter\">Status</label>\n        <select id=\"status-filter\">\n          <option value=\"all\">All statuses</option>\n          <option value=\"paid\">Paid</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"refunded\">Refunded</option>\n          <option value=\"failed\">Failed</option>\n        </select>\n      </div>\n      <div class=\"stack gap-sm\" style=\"flex:0 0 auto\">\n        <span class=\"label\">&nbsp;</span>\n        <div class=\"row gap-sm\">\n          <button class=\"btn btn-secondary\" id=\"reset-btn\" type=\"button\">Reset</button>\n          <button class=\"btn\" id=\"export-btn\" type=\"button\">Export CSV</button>\n        </div>\n      </div>\n    </div>\n    <p class=\"small muted\" id=\"filter-summary\" aria-live=\"polite\">Showing all 10 orders · 1,810.89 total</p>\n  </div>\n\n  <div class=\"card stack gap-sm\">\n    <h2 class=\"card-title\">Order list</h2>\n    <table id=\"orders-table\">\n      <thead>\n        <tr>\n          <th>Order</th>\n          <th>Customer</th>\n          <th>Status</th>\n          <th>Method</th>\n          <th>Items</th>\n          <th>Date</th>\n          <th style=\"text-align:right\">Amount</th>\n        </tr>\n      </thead>\n      <tbody id=\"orders-body\"></tbody>\n    </table>\n    <div id=\"empty-state\" hidden class=\"stack gap-sm\" style=\"padding: 2rem 0; text-align:center\">\n      <h3 class=\"card-title\" style=\"margin:0\">No orders match</h3>\n      <p class=\"muted\">Try a different search term or clear the status filter.</p>\n      <div><button class=\"btn btn-secondary\" id=\"empty-reset\" type=\"button\">Clear filters</button></div>\n    </div>\n  </div>\n\n  <div class=\"grid cols-2\">\n    <div class=\"card\">\n      <h2 class=\"card-title\">Orders by status</h2>\n      <p class=\"card-desc\">Count of orders in each payment status.</p>\n      <div data-chart='{\"type\":\"pie\",\"title\":\"Orders by status\",\"data\":[{\"label\":\"Paid\",\"value\":5},{\"label\":\"Pending\",\"value\":3},{\"label\":\"Refunded\",\"value\":1},{\"label\":\"Failed\",\"value\":1}]}'></div>\n    </div>\n    <div class=\"card\">\n      <h2 class=\"card-title\">Revenue by payment method</h2>\n      <p class=\"card-desc\">Gross order value split across Card, PayPal and Bank transfer.</p>\n      <div data-chart='{\"type\":\"bar\",\"title\":\"Revenue by payment method\",\"data\":[{\"label\":\"Card\",\"value\":789.4},{\"label\":\"Bank transfer\",\"value\":810.24},{\"label\":\"PayPal\",\"value\":448.25}]}'></div>\n    </div>\n  </div>\n\n  <div class=\"card stack gap-sm\">\n    <h2 class=\"card-title\">Largest orders</h2>\n    <p class=\"card-desc\">Top five orders by amount, with their share of gross value.</p>\n    <div data-chart='{\"type\":\"bar\",\"title\":\"Top 5 orders by amount\",\"data\":[{\"label\":\"#1050 Knuth\",\"value\":520.75},{\"label\":\"#1047 Liskov\",\"value\":455},{\"label\":\"#1044 Turing\",\"value\":310.25},{\"label\":\"#1041 Lovelace\",\"value\":240},{\"label\":\"#1046 Thompson\",\"value\":199.99}]}'></div>\n  </div>\n\n  <div class=\"alert alert-destructive\" id=\"failed-note\">\n    <strong>Dennis Ritchie (#1048)</strong> — payment failed on 17 Oct 2026. The customer has been notified; the 72.40 order is not included in collected revenue.\n  </div>\n</div>\n\n<style>\n  #orders-table th, #orders-table td { vertical-align: middle; }\n  #orders-table th:nth-child(6), #orders-table td:nth-child(6) { white-space: nowrap; }\n  #orders-table th:nth-child(7), #orders-table td:nth-child(7) { text-align: right; }\n  #orders-table td .cust { font-weight: 600; }\n  #orders-table td .email { font-size: 0.8125rem; color: var(--muted, #6b7280); }\n  #orders-table td.id { font-variant-numeric: tabular-nums; color: var(--muted, #6b7280); }\n  @media (max-width: 720px) {\n    #orders-table, #orders-table tbody, #orders-table tr, #orders-table td { display: block; width: 100%; }\n    #orders-table thead { display: none; }\n    #orders-table tr { border-bottom: 1px solid var(--border, #e5e7eb); padding: 0.6rem 0; }\n    #orders-table td { display: flex; justify-content: space-between; gap: 1rem; border: 0; padding: 0.15rem 0; text-align: left; }\n    #orders-table td::before { content: attr(data-label); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted, #6b7280); }\n  }\n</style>\n\n<script>\n(function () {\n  var orders = [\n    {id:1041,customer:\"Ada Lovelace\",email:\"ada@example.com\",status:\"paid\",amount:240,date:\"2026-10-02\",items:3,method:\"Card\"},\n    {id:1042,customer:\"Linus Torvalds\",email:\"linus@example.com\",status:\"pending\",amount:89.5,date:\"2026-10-03\",items:1,method:\"Bank transfer\"},\n    {id:1043,customer:\"Grace Hopper\",email:\"grace@example.com\",status:\"refunded\",amount:120,date:\"2026-10-05\",items:2,method:\"Card\"},\n    {id:1044,customer:\"Alan Turing\",email:\"alan@example.com\",status:\"paid\",amount:310.25,date:\"2026-10-08\",items:4,method:\"PayPal\"},\n    {id:1045,customer:\"Margaret Hamilton\",email:\"margaret@example.com\",status:\"paid\",amount:64,date:\"2026-10-11\",items:1,method:\"Card\"},\n    {id:1046,customer:\"Ken Thompson\",email:\"ken@example.com\",status:\"pending\",amount:199.99,date:\"2026-10-14\",items:2,method:\"Bank transfer\"},\n    {id:1047,customer:\"Barbara Liskov\",email:\"barbara@example.com\",status:\"paid\",amount:455,date:\"2026-10-15\",items:5,method:\"Card\"},\n    {id:1048,customer:\"Dennis Ritchie\",email:\"dennis@example.com\",status:\"failed\",amount:72.4,date:\"2026-10-17\",items:1,method:\"Card\"},\n    {id:1049,customer:\"Radia Perlman\",email:\"radia@example.com\",status:\"paid\",amount:138,date:\"2026-10-19\",items:2,method:\"PayPal\"},\n    {id:1050,customer:\"Donald Knuth\",email:\"donald@example.com\",status:\"pending\",amount:520.75,date:\"2026-10-21\",items:6,method:\"Bank transfer\"}\n  ];\n\n  var badgeClass = {paid:\"badge\",pending:\"badge badge-outline\",refunded:\"badge badge-secondary\",failed:\"badge badge-destructive\"};\n  var body = document.getElementById(\"orders-body\");\n  var empty = document.getElementById(\"empty-state\");\n  var summary = document.getElementById(\"filter-summary\");\n  var search = document.getElementById(\"order-search\");\n  var filter = document.getElementById(\"status-filter\");\n  var table = document.getElementById(\"orders-table\");\n  var fmt = new Intl.NumberFormat(\"en-US\",{style:\"currency\",currency:\"USD\"});\n  var months = {\"10\":\"Oct\"};\n\n  function esc(s){return String(s).replace(/[&<>\"]/g,function(c){return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\"}[c];});}\n\n  function money(n){ return fmt.format(n); }\n\n  function shortDate(iso){\n    var p = iso.split(\"-\");\n    return p[2] + \" \" + months[p[1]] + \" \" + p[0];\n  }\n\n  function current(){\n    var q = search.value.trim().toLowerCase();\n    var st = filter.value;\n    return orders.filter(function(o){\n      var matchQ = !q || o.customer.toLowerCase().indexOf(q) > -1 || o.email.toLowerCase().indexOf(q) > -1 || String(o.id).indexOf(q) > -1;\n      var matchS = st === \"all\" || o.status === st;\n      return matchQ && matchS;\n    });\n  }\n\n  function render(){\n    var rows = current();\n    body.innerHTML = rows.map(function(o){\n      return '<tr>'\n        + '<td class=\"id\" data-label=\"Order\">#' + o.id + '</td>'\n        + '<td data-label=\"Customer\"><div class=\"cust\">' + esc(o.customer) + '</div><div class=\"email\">' + esc(o.email) + '</div></td>'\n        + '<td data-label=\"Status\"><span class=\"' + badgeClass[o.status] + '\">' + o.status.charAt(0).toUpperCase() + o.status.slice(1) + '</span></td>'\n        + '<td data-label=\"Method\">' + esc(o.method) + '</td>'\n        + '<td class=\"num\" data-label=\"Items\">' + o.items + '</td>'\n        + '<td data-label=\"Date\">' + shortDate(o.date) + '</td>'\n        + '<td class=\"num\" data-label=\"Amount\">' + money(o.amount) + '</td>'\n        + '</tr>';\n    }).join(\"\");\n\n    table.hidden = rows.length === 0;\n    empty.hidden = rows.length !== 0;\n\n    var total = rows.reduce(function(s,o){return s + o.amount;}, 0);\n    var label = st === \"all\" ? \"all statuses\" : filter.options[filter.selectedIndex].text.toLowerCase();\n    summary.textContent = \"Showing \" + rows.length + \" of \" + orders.length + \" orders (\" + label + \") · \" + money(total) + \" total\";\n  }\n\n  function reset(){\n    search.value = \"\";\n    filter.value = \"all\";\n    render();\n    search.focus();\n  }\n\n  search.addEventListener(\"input\", render);\n  filter.addEventListener(\"change\", render);\n  document.getElementById(\"reset-btn\").addEventListener(\"click\", reset);\n  document.getElementById(\"empty-reset\").addEventListener(\"click\", reset);\n\n  document.getElementById(\"export-btn\").addEventListener(\"click\", function(){\n    var rows = current();\n    var csv = [\"Order ID,Customer,Email,Status,Method,Items,Date,Amount\"]\n      .concat(rows.map(function(o){\n        return [o.id,o.customer,o.email,o.status,o.method,o.items,o.date,o.amount.toFixed(2)].map(function(v){\n          return '\"' + String(v).replace(/\"/g,'\"\"') + '\"';\n        }).join(\",\");\n      })).join(\"\\n\");\n    var blob = new Blob([csv], {type:\"text/csv;charset=utf-8\"});\n    var a = document.createElement(\"a\");\n    a.href = URL.createObjectURL(blob);\n    a.download = \"orders.csv\";\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(a.href);\n  });\n\n  render();\n})();\n</script>","deltas":[[1795,"<div class=\"page stack gap-lg\">\n  <div class=\"stack gap-sm\">\n    <h1>"],[1910,"Orders</h1>\n    <p class=\"lead\">Ten orders placed between 2 and 21 October 2026. Search by customer"],[2051,", email or order ID, and narrow the list by payment status.</p>\n  </div>\n\n  <div class=\"grid cols"],[2164,"-4\">\n    <div class=\"card\">\n      <div class=\"stat-label\">Total orders</div>\n     "],[2316," <div class=\"stat-value\">10</div>\n      <div class=\"small muted\">1,810.89 in gross"],[2474," value</div>\n    </div>\n    <div class=\"card\">\n     "],[2597," <div class=\"stat-label\">Paid</div>\n      <div class=\"stat-value\">5</div>\n      <div class=\"small muted"],[2972,"\">1,207.25 collected</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"stat-label\">Pending</div>\n      <div class=\"stat-value\">3</div>\n      <div class=\"small muted\">810.24 awaiting settlement</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"stat-label\">Refunded &amp; failed</div>\n      <div class=\"stat-value\">2</div>\n      <div class=\"small muted\">192.40 released"],[3377," or lost"],[3562,"</div>\n    </div>\n  </div>\n\n  <div class=\"card stack gap-sm\">\n    <div class=\"row between"],[3678," center gap-sm\">\n      <div class=\"stack gap-sm\" style=\"flex"],[3779,":1 1 320px\">\n        <label class=\"stack gap-sm\" for"],[3931,"=\"order-search\">Search</label>\n        <input id=\"order-search\" type=\"search\" placeholder=\"Search customer, email or ID…\" autocomplete=\"off"],[4060,"\">\n      </div>\n      <div class=\"stack gap-sm\" style=\"flex:0 