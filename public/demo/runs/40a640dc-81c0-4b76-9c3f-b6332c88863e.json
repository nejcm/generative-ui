ip.\n- Cover exactly what the request names, with no extra pages or marketing sections.\n- Use the supplied DATA in full: every field is there to be shown. Derive useful extras from it (shares, totals, deltas, rankings) instead of inventing unrelated numbers.\n- Where it fits, add status badges, trend/change figures, secondary actions, helper text, and sensible empty or edge-case copy.\n- Establish hierarchy with headings, size and weight; group related items; keep spacing and alignment consistent.\n- Make charts readable: a title, labelled axes or values, and a legend for pie charts.\n- Never use lorem ipsum or placeholder names like \"Item 1\".","systemHash":"0c16911c9564c3db3ada7a622931ee6ffc820ebf9a373996782a9f1f0fc3c98c","systemOverridden":false,"strictOutput":false,"rawOutput":"<h1>Account Settings</h1>\n<p class=\"lead\">Manage your profile, notification preferences, and privacy choices.</p>\n<div class=\"grid cols-3\">\n  <div class=\"card\">\n    <div class=\"card-title\">Profile</div>\n    <dl class=\"small\">\n      <dt>Full name</dt><dd>Alex Johnson</dd>\n      <dt>Username</dt><dd>@alexj</dd>\n      <dt>Member since</dt><dd>January 2021</dd>\n      <dt>Account status</dt><dd><span class=\"badge badge-secondary\">Active</span></dd>\n    </dl>\n    <a href=\"#\" class=\"btn btn-outline btn-sm\">Edit profile</a>\n  </div>\n  <div class=\"card\">\n    <div class=\"card-title\">Notifications</div>\n    <form>\n      <label class=\"label.check\"><input type=\"checkbox\"><span>Email notifications</span></label>\n      <label class=\"label.check\"><input type=\"checkbox\" checked><span>Push notifications</span></label>\n      <label class=\"label.check\"><input type=\"checkbox\" checked><span>Marketing emails</span></label>\n      <hr class=\"alert-destructive\">\n      <button type=\"submit\" class=\"btn btn-secondary btn-block\">Save preferences</button>\n    </form>\n  </div>\n  <div class=\"card\">\n    <div class=\"card-title\">Privacy</div>\n    <dl>\n      <dt>Profile visibility</dt>\n      <dd>\n        <label class=\"label.check\"><input type=\"radio\" name=\"privacy\" checked><span>Public</span></label>\n        <label class=\"label.check\"><input type=\"radio\" name=\"privacy\"><span>Friends only</span></label>\n        <label class=\"label.check\"><input type=\"radio\" name=\"privacy\"><span>Private</span></label>\n      </dd>\n      <dt>Ad personalization</dt>\n      <dd><label class=\"label.check\"><input type=\"checkbox\"><span>Allow personalized ads</span></label></dd>\n      <dt>Data download</dt><dd><a href=\"#\" class=\"small\">Download your data</a></dd>\n    </dl>\n  </div>\n</div>","deltas":[[23478,"<h"],[23484,"1"],[23484,">"],[23484,"Account"],[23485," Settings"],[23490,"</h"],[23490,"1"],[23490,">\n"],[23498,"<p"],[23498," class"],[23498,"=\""],[23498,"lead"],[23504,"\">"],[23504,"Manage"],[23504," your"],[23504," profile"],[23515,","],[23515," notification"],[23515," preferences"],[23515,","],[23520," and"],[23520," privacy"],[23520," choices"],[23520,"."],[23531,"</p"],[23534,">\n"],[23534,"<div"],[23534," class"],[23534,"=\""],[23538,"grid"],[23538," cols"],[23538,"-"],[23538,"3"],[23546,"\">\n"],[23546," "],[23553," "],[23553,"<div"],[23553," class"],[23553,"=\""],[23560,"card"],[23560,"\">\n"],[23560,"   "],[23566," "],[23566,"<div"],[23566," class"],[23566,"=\""],[23572,"card"],[23572,"-title"],[23572,"\">"],[23572,"Profile"],[23581,"</div"],[23581,">\n"],[23581,"   "],[23587," "],[23587,"<dl"],[23587," class"],[23587,"=\""],[23594,"small"],[23594,"\">\n"],[23594,"     "],[23594," "],[23600,"<dt"],[23600,">"],[23600,"Full"],[23600," name"],[23606,"</dt"],[23606,">"],[23606,"<dd"],[23612,">"],[23612,"Alex"],[23612," Johnson"],[23620,"</dd"],[23620,">\n"],[23620,"     "],[23620," "],[23625,"<dt"],[23625,">"],[23625,"Username"],[23641,"</dt"],[23641,">"],[23641,"<dd"],[23641,">"],[23642,"@"],[23643,"al"],[23643,"ex"],[23643,"j"],[23647,"</dd"],[23647,">\n"],[23657,"     "],[23657," "],[23657,"<