y what the request names, with no extra pages or marketing sections.\n- Use the supplied DATA in full: every field is there to be shown. Derive useful extras from it (shares, totals, deltas, rankings) instead of inventing unrelated numbers.\n- Where it fits, add status badges, trend/change figures, secondary actions, helper text, and sensible empty or edge-case copy.\n- Establish hierarchy with headings, size and weight; group related items; keep spacing and alignment consistent.\n- Make charts readable: a title, labelled axes or values, and a legend for pie charts.\n- Never use lorem ipsum or placeholder names like \"Item 1\".","systemHash":"0c16911c9564c3db3ada7a622931ee6ffc820ebf9a373996782a9f1f0fc3c98c","systemOverridden":false,"strictOutput":false,"rawOutput":"<main class=\"page stack gap-lg\">\n  <header class=\"stack gap-sm center\">\n    <p class=\"badge badge-secondary\">Pricing</p>\n    <h1>Choose a plan that fits your workflow</h1>\n    <p class=\"lead\">Organize projects, keep work moving, and add collaboration as your team grows.</p>\n    <p class=\"muted\">Prices are per seat, billed monthly. Change or cancel your plan anytime.</p>\n  </header>\n\n  <section id=\"plans\" class=\"grid cols-3 gap-lg\" aria-label=\"Plans\">\n    <article class=\"card stack gap-sm\">\n      <div class=\"between row\">\n        <h2 class=\"h3\">Free</h2>\n        <span class=\"badge badge-outline\">For individuals</span>\n      </div>\n      <p class=\"card-desc\">Get started with the essentials for organizing your work.</p>\n      <div class=\"row center gap-sm\">\n        <span class=\"stat-value\">$0</span>\n        <span class=\"muted\">forever</span>\n      </div>\n      <p class=\"small muted\">No credit card required</p>\n      <a class=\"btn btn-secondary btn-block\" href=\"#plans\">Choose Free</a>\n      <hr class=\"hr\">\n      <p class=\"small\"><strong>Included features</strong></p>\n      <ul class=\"stack gap-sm\">\n        <li>1 seat</li>\n        <li>Up to 3 active projects</li>\n        <li>Task boards and basic views</li>\n        <li>1 GB file storage</li>\n        <li>Community support</li>\n      </ul>\n    </article>\n\n    <article class=\"card stack gap-sm\">\n      <div class=\"between row\">\n        <h2 class=\"h3\">Pro</h2>\n        <span class=\"badge\">Most popular</span>\n      </div>\n      <p class=\"card-desc\">More flexibility and automation for your growing workload.</p>\n      <div class=\"row center gap-sm\">\n        <span class=\"stat-value\">$12</span>\n        <span class=\"muted\">/ seat / month</span>\n      </div>\n      <p class=\"small muted\">Billed monthly</p>\n      <a class=\"btn btn-block\" href=\"#plans\">Start Pro trial</a>\n      <hr class=\"hr\">\n      <p class=\"small\"><strong>Everything in Free, plus</strong></p>\n      <ul class=\"stack gap-sm\">\n        <li>Unlimited active projects</li>\n        <li>Timeline and calendar views</li>\n        <li>25 automations per seat / month</li>\n        <li>100 GB file storage per seat</li>\n        <li>Guest sharing and priority support</li>\n      </ul>\n    </article>\n\n    <article class=\"card stack gap-sm\">\n      <div class=\"between row\">\n        <h2 class=\"h3\">Team</h2>\n        <span class=\"badge badge-secondary\">For teams</span>\n      </div>\n      <p class=\"card-desc\">Shared tools and controls to help your whole team stay in sync.</p>\n      <div class=\"row center gap-sm\">\n        <span class=\"stat-value\">$24</span>\n        <span class=\"muted\">/ seat / month</span>\n      </div>\n      <p class=\"small muted\">Billed monthly · 3-seat minimum</p>\n      <a class=\"btn btn-secondary btn-block\" href=\"#plans\">Start Team trial</a>\n      <hr class=\"hr\">\n      <p class=\"small\"><strong>Everything in Pro, plus</strong></p>\n      <ul class=\"stack gap-sm\">\n        <li>Shared team workspaces</li>\n        <li>Unlimited automations</li>\n        <li>Admin roles and access controls</li>\n        <li>1 TB shared file storage</li>\n        <li>Priority team support</li>\n      </ul>\n    </article>\n  </section>\n\n  <p class=\"small muted center\">Need fewer seats? Start with Free and upgrade whenever you’re ready.</p>\n</main>","deltas":[[15382,"<"],[15384,"main"],[15386," class"],[15390,"=\""],[15393,"page"],[15396," stack"],[15400," gap"],[15402,"-lg"],[15408,"\">\n"],[15414," "],[15417," <"],[15423,"header"],[15425," class"],[15430,"=\""],[15431,"stack"],[15436," gap"],[15439,"-sm"],[15442," center"],[15446,"\">\n"],[15448,"   "],[15450," <"],[15453,"p"],[15457," class"],[15459,"=\""],[15464,"badge"],[15468," badge"],[15471,"-secondary"],[15475,"\">"],[15479,"Pricing"],[15482,"</"],[15483,"p"],[15485,">\n"],[15487,"   "],[15491," <"],[15493,"h"],[15497,"1"],[15501,">"],[15505,"Choose"],[15512," a"],[15514," plan"],[15518," that"],[15519," fits"],[15522," your"],[15526," workflow"],[15530,"</"],[15533,"h"],[15535,"1"],[15539,">\n"],[15544,"   "],[15546," <"],[15549,"p"],[15563," class"],[15563,"=\""],[15563,"lead"],[15564,"\">"],[15564,"Organ"],[15568,"ize"],[15572," projects"],[15574,","],[15579," keep"],[15581," work"],[15584," moving"],[15588,","],[15590," and"],[15593," add"],[15597," collaboration"],[15601," as"],[15604," your"],[15607," team"],[15609," grows"],[15611,".</"],[15615,"p"],[15620,">\n"],[15624,"   "],[15627," <"],[15630,"p"],[15636," class"],[15639,"=\""],[15641,"mut"],[15647,"ed"],[15651,"\">"],[15656,"Prices"],[15657," are"],[15664," per"],[15666," seat"],[15668,","],[15672," billed"],[15674," monthly"],[15678,"."],[15681," Change"],[15683," or"],[15688," cancel"],[15691," your"],[15693," plan"],[15696," anytime"],[15699,".</"],[15702,"p"],[15709,">\n"],[15712," "],[15714," </"],[15716,"header"],[15716,">\n\n"],[15719," "],[15719," <"],[15724,"section"],[15727," id"],[15730,"=\""],[15734,"plans"],[15739,"\""],[15743," class"],[15746,"=\""],[15748,"grid"],[15751," cols"],[15753,"-"],[15757,"3"],[15762," gap"],[15764,"-lg"],[15767,"\""],[15771," 