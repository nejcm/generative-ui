isible = 0;\n\n    rows.forEach(row => {\n      const matchesSearch = row.textContent.toLowerCase().includes(query);\n      const matchesStatus = !status || row.dataset.status === status;\n      const show = matchesSearch && matchesStatus;\n      row.hidden = !show;\n      if (show) visible++;\n    });\n\n    document.getElementById('resultCount').textContent =\n      `${visible} ${visible === 1 ? 'order' : 'orders'}`;\n    document.getElementById('emptyState').hidden = visible !== 0;\n    document.getElementById('ordersTable').hidden = visible === 0;\n  }\n\n  function resetOrders() {\n    searchInput.value = '';\n    statusSelect.value = '';\n    filterOrders();\n  }\n\n  searchInput.addEventListener('input', filterOrders);\n  statusSelect.addEventListener('change', filterOrders);\n</script>","deltas":[[3431,"<"],[3433,"main"],[3438," class"],[3445,"=\""],[3449,"page"],[3454," stack"],[3456," gap"],[3460,"-lg"],[3462,"\">\n"],[3467," "],[3470," <"],[3472,"header"],[3476," class"],[3481,"=\""],[3482,"between"],[3484," gap"],[3494,"-lg"],[3494,"\">\n"],[3496,"   "],[3499," <"],[3501,"div"],[3505," class"],[3508,"=\""],[3515,"stack"],[3517," gap"],[3522,"-sm"],[3527,"\">\n"],[3531,"     "],[3535," <"],[3536,"h"],[3539,"1"],[3542,">"],[3545,"Orders"],[3549,"</"],[3553,"h"],[3555,"1"],[3557,">\n"],[3562,"     "],[3566," <"],[3566,"p"],[3573," class"],[3576,"=\""],[3580,"lead"],[3588,"\">"],[3595,"Search"],[3598," and"],[3610," review"],[3610," customer"],[3615," orders"],[3622,","],[3628," payment"],[3630," status"],[3633,","],[3636," and"],[3639," totals"],[3644,".</"],[3646,"p"],[3653,">\n"],[3655,"   "],[3659," </"],[3661,"div"],[3664,">\n"],[3669,"   "],[3673," <"],[3676,"button"],[3679," class"],[3682,"=\""],[3690,"btn"],[3694," btn"],[3705,"-outline"],[3705,"\""],[3705," type"],[3708,"=\""],[3716,"button"],[3721,"\""],[3726," onclick"],[3728,"=\""],[3731,"reset"],[3739,"Orders"],[3744,"()\">"],[3748,"Reset"],[3752," filters"],[3754,"</"],[3760,"button"],[3762,">\