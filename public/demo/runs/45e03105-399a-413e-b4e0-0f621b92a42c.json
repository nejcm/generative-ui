ss=\"stat-label\">Pending</span>\n        <span class=\"stat-value\">$810.24</span>\n        <span class=\"small muted\">3 orders awaiting payment</span>\n      </div>\n      <div class=\"card stack gap-sm\">\n        <span class=\"stat-label\">Issues</span>\n        <span class=\"stat-value\">$192.40</span>\n        <span class=\"small down\">1 refunded · 1 failed</span>\n      </div>\n    </div>\n\n    <div class=\"card stack gap-lg\">\n      <div class=\"between row wrap gap-sm\">\n        <div class=\"row gap-sm wrap\">\n          <label class=\"label\" style=\"position:relative\">\n            <input type=\"search\" id=\"search\" placeholder=\"Search by customer, email or order ID…\" style=\"min-width:260px\" />\n          </label>\n          <label class=\"label\">\n            <select id=\"statusFilter\">\n              <option value=\"all\">All statuses</option>\n              <option value=\"paid\">Paid</option>\n              <option value=\"pending\">Pending</option>\n              <option value=\"refunded\">Refunded</option>\n              <option value=\"failed\">Failed</option>\n            </select>\n          </label>\n          <label class=\"label\">\n            <select id=\"methodFilter\">\n              <option value=\"all\">All methods</option>\n              <option value=\"Card\">Card</option>\n              <option value=\"PayPal\">PayPal</option>\n              <option value=\"Bank transfer\">Bank transfer</option>\n            </select>\n          </label>\n        </div>\n        <span class=\"small muted\" id=\"count\"></span>\n      </div>\n\n      <div style=\"overflow-x:auto\">\n        <table id=\"ordersTable\">\n          <thead>\n            <tr>\n              <th>Order</th>\n              <th>Customer</th>\n              <th>Date</th>\n              <th>Items</th>\n              <th>Method</th>\n              <th class=\"num\">Amount</th>\n              <th>Status</th>\n              <th></th>\n            </tr>\n          </thead>\n          <tbody id=\"tbody\"></tbody>\n        </table>\n      </div>\n      <p class=\"small muted\" id=\"empty\" style=\"display:none\">No orders match your search or filters. Try clearing the filters or using a different term.</p>\n    </div>\n\n    <div data-chart='{\"type\":\"bar\",\"title\":\"Revenue by order\",\"data\":[{\"label\":\"#1041\",\"value\":240},{\"label\":\"#1042\",\"value\":89.5},{\"label\":\"#1043\",\"value\":120},{\"label\":\"#1044\",\"value\":310.25},{\"label\":\"#1045\",\"value\":64},{\"label\":\"#1046\",\"value\":199.99},{\"label\":\"#1047\",\"value\":455},{\"label\":\"#1048\",\"value\":72.4},{\"label\":\"#1049\",\"value\":138},{\"label\":\"#1050\",\"value\":520.75}]}'></div>\n  </div>\n</div>\n\n<style>\n  .status-badge { display:inline-flex; align-items:center; gap:6px; }\n  .status-dot { width:8px; height:8px; border-radius:50%; display:inline-block; }\n</style>\n\n<script>\n  const orders = [\n    {id:1041,customer:\"Ada Lovelace\",email:\"ada@example.com\",status:\"paid\",amount:240,date:\"2026-10-02\",items:3,method:\"Card\"},\n    {id:1042,customer:\"Linus Torvalds\",email:\"linus@example.com\",status:\"pending\",amount:89.5,date:\"2026-10-03\",items:1,method:\"Bank transfer\"},\n    {id:1043,customer:\"Grace Hopper\",email:\"grace@example.com\",status:\"refunded\",amount:120,date:\"2026-10-05\",items:2,method:\"Card\"},\n    {id:1044,customer:\"Alan Turing\",email:\"alan@example.com\",status:\"paid\",amount:310.25,date:\"2026-10-08\",items:4,method:\"PayPal\"},\n    {id:1045,customer:\"Margaret Hamilton\",email:\"margaret@example.com\",status:\"paid\",amount:64,date:\"2026-10-11\",items:1,method:\"Card\"},\n    {id:1046,customer:\"Ken Thompson\",email:\"ken@example.com\",status:\"pending\",amount:199.99,date:\"2026-10-14\",items:2,method:\"Bank transfer\"},\n    {id:1047,customer:\"Barbara Liskov\",email:\"barbara@example.com\",status:\"paid\",amount:455,date:\"2026-10-15\",items:5,method:\"Card\"},\n    {id:1048,customer:\"Dennis Ritchie\",email:\"dennis@example.com\",status:\"failed\",amount:72.4,date:\"2026-10-17\",items:1,method:\"Card\"},\n    {id:1049,customer:\"Radia Perlman\",email:\"radia@example.com\",status:\"paid\",amount:138,date:\"2026-10-19\",items:2,method:\"PayPal\"},\n    {id:1050,customer:\"Donald Knuth\",email:\"donald@example.com\",status:\"pending\",amount:520.75,date:\"2026-10-21\",items:6,method:\"Bank transfer\"}\n  ];\n\n  const badgeClass = {paid:\"badge\", pending:\"badge-secondary\", refunded:\"badge-outline\", failed:\"badge-destructive\"};\n  const dotColor = {paid:\"#22c55e\", pending:\"#eab308\", refunded:\"#6b7280\", failed:\"#ef4444\"};\n\n  const tbody = document.getElementById(\"tbody\");\n  const search = document.getElementById(\"search\");\n  const statusFilter = document.getElementById(\"statusFilter\");\n  const methodFilter = document.getElementById(\"methodFilter\");\n  const countEl = document.getElementById(\"count\");\n  const emptyEl = document.getElementById(\"empty\");\n\n  function fmtDate(d) {\n    return new Date(d + \"T00:00:00\").toLocaleDateString(\"en-GB\", {day:\"numeric\", month:\"short\", year:\"numeric\"});\n  }\n\n  function render() {\n    const q = search.value.trim().toLowerCase();\n    const st = statusFilter.value;\n    const m = methodFilter.value;\n    const rows = orders.filter(o =>\n      (st === \"all\" || o.status === st) &&\n      (m === \"all\" || o.method === m) &&\n      (!q || String(o.id).includes(q) || o.customer.toLowerCase().includes(q) || o.email.toLowerCase().includes(q))\n    );\n\n    tbody.innerHTML = rows.map(o => `\n      <tr>\n        <td><strong>#${o.id}</strong></td>\n        <td>\n          <div class=\"row gap-sm\" style=\"align-items:center\">\n            <span class=\"avatar\">${o.customer.split(\" \").map(p=>p[0]).join(\"\")}</span>\n            <div>\n              <div>${o.customer}</div>\n              <div class=\"small muted\">${o.email}</div>\n            </div>\n          </div>\n        </td>\n        <td>${fmtDate(o.date)}</td>\n        <td>${o.items}</td>\n        <td>${o.method}</td>\n        <td class=\"num\"><strong>$${o.amount.toFixed(2)}</strong></td>\n        <td><span class=\"status-badge ${badgeClass[o.status]}\"><span class=\"status-dot\" style=\"background:${dotColor[o.status]}\"></span>${o.status.charAt(0).toUpperCase()+o.status.slice(1)}</span></td>\n        <td><button class=\"btn btn-ghost btn-sm\">View</button></td>\n      </tr>`).join(\"\");\n\n    countEl.textContent = `Showing ${rows.length} of ${orders.length} orders`;\n    emptyEl.style.display = rows.length ? \"none\" : \"block\";\n  }\n\n  search.addEventListener(\"input\", render);\n  statusFilter.addEventListener(\"change\", render);\n  methodFilter.addEventListener(\"change\", render);\n  render();\n</script>","deltas":[[3425,"<div"],[3425," class"],[3425,"=\""],[3425,"page"],[3425,"\">\n"],[3425," "],[3425," <"],[3425,"div"],[3425," class"],[3425,"=\""],[3425,"stack"],[3425," gap"],[3425,"-lg"],[3425,"\">\n"],[3425,"   "],[3425," <"],[3426,"div"],[3426," class"],[3426,"=\""],[3426,"stack"],[3426," gap"],[3426,"-sm"],[3426,"\">\n"],[3426,"     "],[3426," <"],[3426,"h"],[3426,"1"],[3426,">"],[3426,"Orders"],[3426,"</h"],[3426,"1"],[3426,">\n"],[3426,"     "],[3426," <"],[3426,"p"],[3426," class"],[3426,"=\""],[3426,"m"],[3426,"uted"],[3426,"\">"],[3426,"Recent"],[3426," orders"],[3426," placed"],[3426," in"],[3426," your"],[3426," store"],[3426,"."],[3426," Click"],[3426," a"],[3440," row"],[3440," to"],[3440," view"],[3440," details"],[3440,"."],[3440," Total"],[3440," of"],[3440," "],[3440,"10"],[3440," orders"],[3440," in"],[3440," October"],[3440," "],[3440,"202"],[3440,"6"],[3440,".</"],[3440,"p"],[3440,">\n"],[3440,"   "],[3440," </"],[3440,"div"],[3440,">\n\n"],[3440,"   "],[3440," <"],[3440,"div"],[3440," class"],[3440,"=\""],[3440,"grid"],[3440," cols"],[3440,"-"],[4309,"4"],[4322,"\">\n"],[4322,"     "],[4322," <"],[4322,"div"],[4322," class"],[4322,"=\""],[4322