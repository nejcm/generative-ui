l muted\">All statuses</div>\n  </div>\n</div>\n\n<div class=\"row\" style=\"margin-bottom:1rem; gap:0.75rem;\">\n  <label style=\"flex:1; min-width:200px;\">\n    Search\n    <input type=\"text\" id=\"searchInput\" placeholder=\"Customer, email, or order ID…\" />\n  </label>\n  <label style=\"min-width:160px;\">\n    Status\n    <select id=\"statusFilter\">\n      <option value=\"all\">All statuses</option>\n      <option value=\"paid\">Paid</option>\n      <option value=\"pending\">Pending</option>\n      <option value=\"refunded\">Refunded</option>\n      <option value=\"failed\">Failed</option>\n    </select>\n  </label>\n  <label style=\"min-width:150px;\">\n    Method\n    <select id=\"methodFilter\">\n      <option value=\"all\">All methods</option>\n      <option value=\"Card\">Card</option>\n      <option value=\"Bank transfer\">Bank transfer</option>\n      <option value=\"PayPal\">PayPal</option>\n    </select>\n  </label>\n  <div style=\"display:flex;align-items:flex-end;\">\n    <button class=\"btn btn-ghost btn-sm\" id=\"resetBtn\">Reset</button>\n  </div>\n</div>\n\n<div class=\"card\" style=\"padding:0;\">\n  <table id=\"ordersTable\">\n    <thead>\n      <tr>\n        <th>Order</th>\n        <th>Customer</th>\n        <th>Status</th>\n        <th>Date</th>\n        <th class=\"num\">Items</th>\n        <th class=\"num\">Amount</th>\n        <th>Method</th>\n      </tr>\n    </thead>\n    <tbody id=\"ordersBody\">\n    </tbody>\n  </table>\n  <div id=\"emptyState\" style=\"display:none; padding:2rem; text-align:center;\">\n    <p class=\"muted\">No orders match your filters.</p>\n  </div>\n</div>\n\n<p class=\"small muted\" id=\"rowCount\" style=\"margin-top:0.75rem;\"></p>\n\n<script>\nconst orders = [\n  { id: 1041, customer: \"Ada Lovelace\", email: \"ada@example.com\", status: \"paid\", amount: 240, date: \"2026-10-02\", items: 3, method: \"Card\" },\n  { id: 1042, customer: \"Linus Torvalds\", email: \"linus@example.com\", status: \"pending\", amount: 89.5, date: \"2026-10-03\", items: 1, method: \"Bank transfer\" },\n  { id: 1043, customer: \"Grace Hopper\", email: \"grace@example.com\", status: \"refunded\", amount: 120, date: \"2026-10-05\", items: 2, method: \"Card\" },\n  { id: 1044, customer: \"Alan Turing\", email: \"alan@example.com\", status: \"paid\", amount: 310.25, date: \"2026-10-08\", items: 4, method: \"PayPal\" },\n  { id: 1045, customer: \"Margaret Hamilton\", email: \"margaret@example.com\", status: \"paid\", amount: 64, date: \"2026-10-11\", items: 1, method: \"Card\" },\n  { id: 1046, customer: \"Ken Thompson\", email: \"ken@example.com\", status: \"pending\", amount: 199.99, date: \"2026-10-14\", items: 2, method: \"Bank transfer\" },\n  { id: 1047, customer: \"Barbara Liskov\", email: \"barbara@example.com\", status: \"paid\", amount: 455, date: \"2026-10-15\", items: 5, method: \"Card\" },\n  { id: 1048, customer: \"Dennis Ritchie\", email: \"dennis@example.com\", status: \"failed\", amount: 72.4, date: \"2026-10-17\", items: 1, method: \"Card\" },\n  { id: 1049, customer: \"Radia Perlman\", email: \"radia@example.com\", status: \"paid\", amount: 138, date: \"2026-10-19\", items: 2, method: \"PayPal\" },\n  { id: 1050, customer: \"Donald Knuth\", email: \"donald@example.com\", status: \"pending\", amount: 520.75, date: \"2026-10-21\", items: 6, method: \"Bank transfer\" }\n];\n\nconst badgeMap = {\n  paid: 'badge',\n  pending: 'badge badge-secondary',\n  refunded: 'badge badge-outline',\n  failed: 'badge badge-destructive'\n};\n\nfunction formatDate(d) {\n  const dt = new Date(d + 'T00:00:00');\n  return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n}\n\nfunction formatCurrency(n) {\n  return '$' + n.toFixed(2).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n}\n\nfunction render() {\n  const search = document.getElementById('searchInput').value.toLowerCase();\n  const status = document.getElementById('statusFilter').value;\n  const method = document.getElementById('methodFilter').value;\n\n  const filtered = orders.filter(o => {\n    const matchesSearch = !search ||\n      o.customer.toLowerCase().includes(search) ||\n      o.email.toLowerCase().includes(search) ||\n      String(o.id).includes(search);\n    const matchesStatus = status === 'all' || o.status === status;\n    const matchesMethod = method === 'all' || o.method === method;\n    return matchesSearch && matchesStatus && matchesMethod;\n  });\n\n  const tbody = document.getElementById('ordersBody');\n  tbody.innerHTML = filtered.map(o => `\n    <tr>\n      <td><strong>#${o.id}</strong><br><span class=\"small muted\">${o.email}</span></td>\n      <td>${o.customer}</td>\n      <td><span class=\"${badgeMap[o.status]}\">${o.status.charAt(0).toUpperCase() + o.status.slice(1)}</span></td>\n      <td>${formatDate(o.date)}</td>\n      <td class=\"num\">${o.items}</td>\n      <td class=\"num\">${formatCurrency(o.amount)}</td>\n      <td>${o.method}</td>\n    </tr>\n  `).join('');\n\n  const empty = document.getElementById('emptyState');\n  empty.style.display = filtered.length === 0 ? 'block' : 'none';\n\n  document.getElementById('rowCount').textContent =\n    filtered.length === orders.length\n      ? `Showing all ${filtered.length} orders`\n      : `Showing ${filtered.length} of ${orders.length} orders`;\n}\n\ndocument.getElementById('searchInput').addEventListener('input', render);\ndocument.getElementById('statusFilter').addEventListener('change', render);\ndocument.getElementById('methodFilter').addEventListener('change', render);\ndocument.getElementById('resetBtn').addEventListener('click', () => {\n  document.getElementById('searchInput').value = '';\n  document.getElementById('statusFilter').value = 'all';\n  document.getElementById('methodFilter').value = 'all';\n  render();\n});\n\nrender();\n</script>","deltas":[[4583,"<h1>Orders"],[4583,"</h1"],[4721,">\n<p class"],[4721,"=\"lead\">Manage"],[4803," and track"],[4937," all customer orders."],[501