  <button class=\"btn btn-block\" id=\"follow-button\" type=\"button\" aria-pressed=\"false\">Follow</button>\n      <button class=\"btn btn-outline\" type=\"button\" aria-label=\"More profile options\">•••</button>\n    </div>\n  </section>\n</main>\n\n<script>\n  const followButton = document.getElementById(\"follow-button\");\n  const followerCount = document.getElementById(\"follower-count\");\n  let following = false;\n  const initialFollowers = 2418;\n\n  followButton.addEventListener(\"click\", () => {\n    following = !following;\n    followButton.textContent = following ? \"Following\" : \"Follow\";\n    followButton.setAttribute(\"aria-pressed\", String(following));\n    followerCount.textContent = (initialFollowers + (following ? 1 : 0)).toLocaleString();\n  });\n</script>","deltas":[[8425,"<"],[8432,"main"],[8435," class"],[8590,"=\""],[8590,"page"],[8590," stack"],[8590,"\">\n"],[8591," "],[8591," <"],[8591,"section"],[8591," class"],[8591,"=\""],[8591,"card"],[8591," stack"],[8591,"\""],[8591," aria"],[8591,"-labelledby"],[8591,"=\""],[8591,"profile"],[8592,"-name"],[8592,"\">\n"],[8592,"   "],[8592," <"],[8592,"div"],[8592," class"],[8592,"=\""],[8592,"row"],[8592," between"],[8592," gap"],[8592,"-sm"],[8592,"\">\n"],[8592,"     "],[8593," <"],[8614,"div"],[8616," class"],[8616,"=\""],[8649,"row"],[8652," gap"],[8656,"-sm"],[8658,"\">\n"],[8659,"       "],[8693," <"],[8696,"div"],[8696," class"],[8696,"=\""],[8737,"avatar"],[8751,"\""],[8751," aria"],[8767,"-hidden"],[8773,"=\""],[8773,"true"],[8774,"\">"],[8807,"MC"],[8820,"</"],[8824,"div"],[8824,">\n"],[8844,"       "],[8850," <"],[8852,"div"],[8852," class"],[8852,"=\""],[8894,"stack"],[8896,"\">\n"],[8899,"         "],[8919," <"],[8929,"h"],[8958,"1"],[8997," class"],[8999,"=\""],[9004,"h"],[9033,"2"],[9045,"\""],[9047," id"],[9048,"=\""],[9077,"profile"],[9090,"-name"],[9092,"\">"],[9092,"M"],[9110,"aya"],[9122," Chen"],[9126,"</"],[9126,"h"],[9151,"1"],[9153,">\n"],[9157,"         "],[9158," <"