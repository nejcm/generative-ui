        \"research\"\n      ]\n    },\n    {\n      \"title\": \"Clinic booking system\",\n      \"year\": 2025,\n      \"role\": \"Product designer\",\n      \"client\": \"Zdravje Clinics\",\n      \"summary\": \"Self-serve booking that halved front-desk calls.\",\n      \"outcome\": \"58% fewer booking calls; 91% of patients book online.\",\n      \"tags\": [\n        \"web\",\n        \"service design\"\n      ]\n    },\n    {\n      \"title\": \"Open data dashboard\",\n      \"year\": 2024,\n      \"role\": \"Design and front-end\",\n      \"client\": \"City of Ljubljana\",\n      \"summary\": \"City budget explorer used by 30k residents.\",\n      \"outcome\": \"Featured by two national newspapers; open-sourced.\",\n      \"tags\": [\n        \"data viz\"\n      ]\n    }\n  ],\n  \"testimonial\": {\n    \"quote\": \"Mira turned a tangle of requirements into something our riders actually enjoy using.\",\n    \"author\": \"Tina Zupan\",\n    \"role\": \"Head of Digital, LPP\"\n  }\n}","systemHash":"7f7b03405c279f095db892fdd24437dfc241ff3c8abb65e91da9e557823238ce","systemOverridden":false,"strictOutput":false,"rawOutput":"```html\n<div class=\"page\">\n  <header class=\"row between center gap-lg\" style=\"padding: 1.5rem 0;\">\n    <div>\n      <span class=\"up\" style=\"font-weight: 600; font-size: 0.875rem;\">Mira Kovač</span>\n    </div>\n    <nav class=\"row gap-sm\">\n      <a href=\"#work\" class=\"btn btn-ghost btn-sm\">Work</a>\n      <a href=\"#about\" class=\"btn btn-ghost btn-sm\">About</a>\n      <a href=\"#contact\" class=\"btn btn-ghost btn-sm\">Contact</a>\n    </nav>\n  </header>\n\n  <section class=\"stack gap-lg\" style=\"padding: 3rem 0;\">\n    <div class=\"row between center\" style=\"flex-wrap: wrap;\">\n      <div class=\"stack gap-sm\" style=\"max-width: 640px;\">\n        <h1>Mira Kovač</h1>\n        <p class=\"lead\" style=\"color: var(--muted, #666);\">Product designer — Ljubljana</p>\n        <p style=\"line-height: 1.7;\">I design calm, usable software for public services and small teams. Ten years across research, interaction design and front-end prototyping.</p>\n        <p class=\"small\" style=\"margin-top: 0.25rem;\">\n          <span class=\"badge badge-outline\">Open to freelance work from January</span>\n        </p>\n        <div class=\"row gap-sm\" style=\"margin-top: 0.5rem;\">\n          <a href=\"mailto:mira@example.com\" class=\"btn btn-primary\">Get in touch</a>\n          <button class=\"btn btn-secondary btn-sm\" id=\"cvBtn\">Download CV</button>\n        </div>\n        <div class=\"row gap-sm\" style=\"margin-top: 0.25rem;\">\n          <span class=\"small muted\">Dribbble · LinkedIn · Read.cv</span>\n        </div>\n      </div>\n      <div class=\"stack gap-sm\" style=\"min-width: 280px;\">\n        <div class=\"card\">\n          <div class=\"row between center\">\n            <span class=\"stat-label\">Years designing</span>\n            <span class=\"stat-value\">10</span>\n          </div>\n          <hr>\n          <div class=\"row between center\">\n            <span class=\"stat-label\">Products shipped</span>\n            <span class=\"stat-value\">24</span>\n          </div>\n          <hr>\n          <div class=\"row between center\">\n            <span class=\"stat-label\">People reached</span>\n            <span class=\"stat-value\">1.2M</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"about\" class=\"stack gap-lg\" style=\"padding: 2rem 0;\">\n    <h2>Skills</h2>\n    <div class=\"row gap-sm\" style=\"flex-wrap: wrap;\">\n      <span class=\"badge\">Interaction design</span>\n      <span class=\"badge\">User research</span>\n      <span class=\"badge\">Design systems</span>\n      <span class=\"badge\">Prototyping</span>\n      <span class=\"badge\">Service design</span>\n    </div>\n  </section>\n\n  <section id=\"work\" class=\"stack gap-lg\" style=\"padding: 2rem 0;\">\n    <div class=\"row between center\">\n      <h2>Selected work</h2>\n      <div class=\"row gap-sm\">\n        <button class=\"btn btn-ghost btn-sm filter-btn active\" data-filter=\"all\">All</button>\n        <button class=\"btn btn-ghost btn-sm filter-btn\" data-filter=\"research\">Research</button>\n        <button class=\"btn btn-ghost btn-sm filter-btn\" data-filter=\"service design\">Service</button>\n      </div>\n    </div>\n    <p class=\"muted small\" id=\"projectCount\">3 projects</p>\n\n    <div class=\"stack gap-lg\" id=\"projectsContainer\">\n      <div class=\"card project-card\" data-tags=\"mobile research\">\n        <div class=\"row between center\" style=\"flex-wrap: wrap; gap: 0.5rem;\">\n          <div class=\"stack gap-sm\" style=\"flex: 1; min-width: 240px;\">\n            <div class=\"row gap-sm\">\n              <h3 class=\"card-title\" style=\"margin: 0;\">Transit app redesign</h3>\n              <span class=\"badge badge-outline\">2026</span>\n            </div>\n            <p class=\"muted small\">Lead designer · Ljubljana Public Transport</p>\n            <p style=\"margin: 0.5rem 0 0;\">Cut trip-planning taps from 7 to 3 for 400k riders.</p>\n            <p class=\"small\"><span class=\"up\">App store rating rose from 3.4 to 4.6 in six months.</span></p>\n            <div class=\"row gap-sm\" style=\"margin-top: 0.5rem;\">\n              <span class=\"badge badge-secondary\">mobile</span>\n              <span class=\"badge badge-secondary\">research</span>\n            </div>\n          </div>\n          <div style=\"width: 160px; min-width: 120px;\">\n            <div data-chart='{\"type\":\"bar\",\"title\":\"Rating change\",\"data\":[{\"label\":\"Before\",\"value\":3.4},{\"label\":\"After\",\"value\":4.6}]}'></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"card project-card\" data-tags=\"web service design\">\n        <div class=\"row between center\" style=\"flex-wrap: wrap; gap: 0.5rem;\">\n          <div class=\"stack gap-sm\" style=\"flex: 1; min-width: 240px;\">\n            <div class=\"row gap-sm\">\n              <h3 class=\"card-title\" style=\"margin: 0;\">Clinic booking system</h3>\n              <span class=\"badge badge-outline\">2025</span>\n            </div>\n            <p class=\"muted small\">Product designer · Zdravje Clinics</p>\n            <p style=\"margin: 0.5rem 0 0;\">Self-serve booking that halved front-desk calls.</p>\n            <p class=\"small\"><span class=\"up\">58% fewer booking calls; 91% of patients book online.</span></p>\n            <div class=\"row gap-sm\" style=\"margin-top: 0.5rem;\">\n              <span class=\"badge badge-secondary\">web</span>\n              <span class=\"badge badge-secondary\">service design</span>\n            </div>\n          </div>\n          <div style=\"width: 160px; min-width: 120px;\">\n            <div data-chart='{\"type\":\"pie\",\"title\":\"Booking channel share\",\"data\":[{\"label\":\"Online\",\"value\":91},{\"label\":\"Phone\",\"value\":58}]}'></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"card project-card\" data-tags=\"data viz\">\n        <div class=\"row between center\" style=\"flex-wrap: wrap; gap: 0.5rem;\">\n          <div class=\"stack gap-sm\" style=\"flex: 1; min-width: 240px;\">\n            <div class=\"row gap-sm\">\n              <h3 class=\"card-title\" style=\"margin: 0;\">Open data dashboard</h3>\n              <span class=\"badge badge-outline\">2024</span>\n            </div>\n            <p class=\"muted small\">Design and front-end · City of Ljubljana</p>\n            <p style=\"margin: 0.5rem 0 0;\">City budget explorer used by 30k residents.</p>\n            <p class=\"small\"><span class=\"up\">Featured by two national newspapers; open-sourced.</span></p>\n            <div class=\"row gap-sm\" style=\"margin-top: 0.5rem;\">\n              <span class=\"badge badge-secondary\">data viz</span>\n            </div>\n          </div>\n          <div style=\"width: 160px; min-width: 120px;\">\n            <div data-chart='{\"type\":\"area\",\"title\":\"Users over time\",\"data\":[{\"label\":\"Month 1\",\"value\":2000},{\"label\":\"Month 6\",\"value\":12000},{\"label\":\"Month 12\",\"value\":30000}]}'></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"stack gap-lg\" style=\"padding: 2rem 0;\">\n    <h2>What people say</h2>\n    <div class=\"card\" style=\"border-left: 4px solid var(--primary, #3b82f6);\">\n      <p style=\"font-size: 1.125rem; font-style: italic; margin: 0 0 0.75rem;\">\"Mira turned a tangle of requirements into something our riders actually enjoy using.\"</p>\n      <p class=\"small\" style=\"margin: 0;\"><strong>Tina Zupan</strong> — Head of Digital, LPP</p>\n    </div>\n  </section>\n\n  <section id=\"contact\" class=\"stack gap-lg\" style=\"padding: 2rem 0;\">\n    <h2>Get in touch</h2>\n    <p class=\"lead\" style=\"color: var(--muted, #666);\">Open to freelance work from January 2026.</p>\n    <div class=\"row gap-sm\">\n      <a href=\"mailto:mira@example.com\" class=\"btn btn-primary btn-lg\">mira@example.com</a>\n      <a href=\"#\" class=\"btn btn-secondary btn-lg\">Download CV</a>\n    </div>\n  </section>\n\n  <footer style=\"padding: 2rem 0; border-top: 1px solid var(--border, #e5e7eb);\" class=\"row between center\">\n    <span class=\"small muted\">© 2025 Mira Kovač</span>\n    <div class=\"row gap-sm\">\n      <span class=\"small muted\">Dribbble · LinkedIn · Read.cv</span>\n    </div>\n  </footer>\n</div>\n\n<script>\n  document.querySelectorAll('.filter-btn').forEach(btn => {\n    btn.addEventListener('click', () => {\n      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));\n      btn.classList.add('active');\n      const filter = btn.dataset.filter;\n      const cards = document.querySelectorAll('.project-card');\n      let visible = 0;\n      cards.forEach(card => {\n        const tags = (card.dataset.tags || '').split(' ');\n        const show = filter === 'all' || tags.includes(filter);\n        card.style.display = show ? '' : 'none';\n        if (show) visible++;\n      });\n      document.getElementById('projectCount').textContent = visible + ' project' + (visible !== 1 ? 's' : '');\n    });\n  });\n\n  document.getElementById('cvBtn').addEventListener('click', () => {\n    const btn = document.getElementById('cvBtn');\n    const original = btn.textContent;\n    btn.textContent = 'Saved ✓';\n    setTimeout(() => btn.textContent = original, 1500);\n  });\n</script>\n\n<style>\n  .filter-btn.active {\n    background: var(--primary, #3b82f6);\n    color: #fff;\n    border-color: var(--primary, #3b82f6);\n  }\n  .project-card {\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\n  }\n  .project-card:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 24px rgba(0,0,0,0.08);\n  }\n  .card {\n    border-left: 3px solid transparent;\n    transition: border-color 0.2s ease;\n  }\n  .card:hover {\n    border-left-color: var(--primary, #3b82f6);\n  }\n  .btn-primary {\n    background: var(--primary, #3b82f6);\n    color: #fff;\n    border: none;\n  }\n  .btn-primary:hover {\n    opacity: 0.9;\n  }\n  .up {\n    color: #16a34a;\n    font-weight: 600;\n  }\n</style>\n```","deltas":[[4896,"```html"],[4896,"\n<div class=\""],[4940,"page\">\n  <"],[4940,"header class=\"row"],[4981," between center"],[4981," gap-lg"],[5048,"\" style=\"padding"],[5048,": 1"],[5048,".5rem "],[5116,"0;\">\n"],[5116,"    <div>\n"],[5116,"      <span"],[5184," class=\"up"],[5184,"\""],[5184," style=\"font-weight"],[5433,": 600;"],[5433," font"],[5433,"-size: 0"],[5434,".875rem;\">"],[5493,"Mira Kova"],[5493,"č</span>\n"],[5493,"   "],[5538," </div>\n   "],[5538," <nav class"],[5587,"=\"row gap-sm"],[5587,"\">\n      <a"],[5628," href=\"#work"],[5628,"\" class=\"btn"],[5701," btn-"],[5701,"ghost btn"],[5701,"-sm\">Work</"],[5739,"a>\n      <"],[5743,"a href=\"#about"],[5782,"\" class=\"bt