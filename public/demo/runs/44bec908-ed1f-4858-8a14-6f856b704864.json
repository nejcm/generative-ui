\n  {\n    \"name\": \"Nimbus 13\",\n    \"tagline\": \"Everything you need, for less\",\n    \"price\": 999,\n    \"weightKg\": 1,\n    \"batteryH\": 22,\n    \"screen\": \"13\\\" IPS\",\n    \"cpu\": \"6-core, 15 W\",\n    \"ramGb\": 16,\n    \"storageGb\": 256,\n    \"ports\": [\n      \"2x USB-C\",\n      \"headphone\"\n    ],\n    \"rating\": 4.2,\n    \"reviews\": 2310,\n    \"pros\": [\n      \"Lightest\",\n      \"Best battery life\",\n      \"Lowest price\"\n    ],\n    \"cons\": [\n      \"Dimmer screen\",\n      \"Small SSD\"\n    ],\n    \"bestFor\": \"Students and light office work\"\n  }\n]","systemHash":"dcc43620444bd5561aa7a57e09f50adaace10b9cc1a0c5f2f824f41f6ed0f15b","systemOverridden":false,"strictOutput":false,"rawOutput":"<main class=\"page stack gap-lg\">\n  <header class=\"stack gap-sm\">\n    <div class=\"row between\">\n      <span class=\"badge badge-secondary\">Laptop comparison</span>\n      <span class=\"muted\">3 models · prices in USD</span>\n    </div>\n    <h1>Find the right laptop for you</h1>\n    <p class=\"lead\">Compare portability, performance, battery life and value side by side. Start with what matters most, then check the details.</p>\n  </header>\n\n  <section class=\"grid cols-3 gap-lg\" aria-label=\"Quick recommendations\">\n    <article class=\"card stack gap-sm\">\n      <span class=\"badge\">Best for travel</span>\n      <h2 class=\"h3\">Aero 14</h2>\n      <p class=\"card-desc\">A bright OLED screen, long battery life and a light build make it the balanced everyday pick.</p>\n      <div class=\"row between\"><span class=\"stat-label\">Weight</span><strong>1.2 kg</strong></div>\n      <div class=\"row between\"><span class=\"stat-label\">Battery</span><strong>18 hours</strong></div>\n      <div class=\"row between\"><span class=\"stat-label\">Price</span><strong>$1,299</strong></div>\n    </article>\n    <article class=\"card stack gap-sm\">\n      <span class=\"badge badge-secondary\">Best for power</span>\n      <h2 class=\"h3\">Forge 16</h2>\n      <p class=\"card-desc\">The strongest configuration, upgradeable memory and a full port selection suit demanding creative work.</p>\n      <div class=\"row between\"><span class=\"stat-label\">CPU</span><strong>16-core · 55 W</strong></div>\n      <div class=\"row between\"><span class=\"stat-label\">Memory</span><strong>32 GB RAM</strong></div>\n      <div class=\"row between\"><span class=\"stat-label\">Price</span><strong>$1,899</strong></div>\n    </article>\n    <article class=\"card stack gap-sm\">\n      <span class=\"badge badge-outline\">Best value</span>\n      <h2 class=\"h3\">Nimbus 13</h2>\n      <p class=\"card-desc\">The lowest price and longest battery life in the group, in the lightest package.</p>\n      <div class=\"row between\"><span class=\"stat-label\">Weight</span><strong>1.0 kg</strong></div>\n      <div class=\"row between\"><span class=\"stat-label\">Battery</span><strong>22 hours</strong></div>\n      <div class=\"row between\"><span class=\"stat-label\">Price</span><strong>$999</strong></div>\n    </article>\n  </section>\n\n  <section class=\"card stack gap-sm\">\n    <h2 class=\"h2\">At a glance</h2>\n    <p class=\"muted\">Choose based on your priorities: Nimbus leads on portability, battery and price; Forge leads on raw specs; Aero balances the two.</p>\n    <div class=\"table\">\n      <table>\n        <thead>\n          <tr>\n            <th scope=\"col\">Attribute</th>\n            <th scope=\"col\">Aero 14</th>\n            <th scope=\"col\">Forge 16</th>\n            <th scope=\"col\">Nimbus 13</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><th scope=\"row\">Tagline</th><td>Light, bright, long-lasting</td><td>Desktop power on the go</td><td>Everything you need, for less</td></tr>\n          <tr><th scope=\"row\">Price</th><td class=\"num\">$1,299</td><td class=\"num\">$1,899</td><td class=\"num\">$999</td></tr>\n          <tr><th scope=\"row\">Weight</th><td class=\"num\">1.2 kg</td><td class=\"num\">2.1 kg</td><td class=\"num\">1.0 kg</td></tr>\n          <tr><th scope=\"row\">Battery life</th><td class=\"num\">18 hours</td><td class=\"num\">9 hours</td><td class=\"num\">22 hours</td></tr>\n          <tr><th scope=\"row\">Screen</th><td>14&quot; OLED</td><td>16&quot; IPS 165Hz</td><td>13&quot; IPS</td></tr>\n          <tr><th scope=\"row\">CPU</th><td>8-core, 15 W</td><td>16-core, 55 W</td><td>6-core, 15 W</td></tr>\n          <tr><th scope=\"row\">RAM</th><td>16 GB</td><td>32 GB</td><td>16 GB</td></tr>\n          <tr><th scope=\"row\">Storage</th><td>512 GB</td><td>1,024 GB</td><td>256 GB</td></tr>\n          <tr>\n            <th scope=\"row\">Ports</th>\n            <td>2x USB-C<br>HDMI<br>headphone</td>\n            <td>2x USB-C<br>3x USB-A<br>HDMI<br>Ethernet<br>SD card</td>\n            <td>2x USB-C<br>headphone</td>\n          </tr>\n          <tr><th scope=\"row\">Rating</th><td>4.6 / 5 <span class=\"muted\">(1,840 reviews)</span></td><td>4.4 / 5 <span class=\"muted\">(960 reviews)</span></td><td>4.2 / 5 <span class=\"muted\">(2,310 reviews)</span></td></tr>\n          <tr><th scope=\"row\">Best for</th><td>Travel and everyday work</td><td>Video editing, 3D and gaming</td><td>Students and light office work</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"stack gap-sm\">\n    <h2 class=\"h2\">Strengths and trade-offs</h2>\n    <div class=\"grid cols-3 gap-lg\">\n      <article class=\"card stack gap-sm\">\n        <h3 class=\"h3\">Aero 14</h3>\n        <div>\n          <span class=\"stat-label\">Pros</span>\n          <ul>\n            <li>Gorgeous OLED panel</li>\n            <li>Great battery</li>\n            <li>Quiet under load</li>\n          </ul>\n        </div>\n        <div>\n          <span class=\"stat-label\">Cons</span>\n          <ul>\n            <li>Soldered RAM</li>\n            <li>Glossy screen</li>\n          </ul>\n        </div>\n      </article>\n      <articl