at the request names, with no extra pages or marketing sections.\n- Use the supplied DATA in full: every field is there to be shown. Derive useful extras from it (shares, totals, deltas, rankings) instead of inventing unrelated numbers.\n- Where it fits, add status badges, trend/change figures, secondary actions, helper text, and sensible empty or edge-case copy.\n- Establish hierarchy with headings, size and weight; group related items; keep spacing and alignment consistent.\n- Make charts readable: a title, labelled axes or values, and a legend for pie charts.\n- Never use lorem ipsum or placeholder names like \"Item 1\".\n\nDATA (build the UI around this content):\n[\n  {\n    \"name\": \"Aero 14\",\n    \"tagline\": \"Light, bright, long-lasting\",\n    \"price\": 1299,\n    \"weightKg\": 1.2,\n    \"batteryH\": 18,\n    \"screen\": \"14\\\" OLED\",\n    \"cpu\": \"8-core, 15 W\",\n    \"ramGb\": 16,\n    \"storageGb\": 512,\n    \"ports\": [\n      \"2x USB-C\",\n      \"HDMI\",\n      \"headphone\"\n    ],\n    \"rating\": 4.6,\n    \"reviews\": 1840,\n    \"pros\": [\n      \"Gorgeous OLED panel\",\n      \"Great battery\",\n      \"Quiet under load\"\n    ],\n    \"cons\": [\n      \"Soldered RAM\",\n      \"Glossy screen\"\n    ],\n    \"bestFor\": \"Travel and everyday work\"\n  },\n  {\n    \"name\": \"Forge 16\",\n    \"tagline\": \"Desktop power on the go\",\n    \"price\": 1899,\n    \"weightKg\": 2.1,\n    \"batteryH\": 9,\n    \"screen\": \"16\\\" IPS 165Hz\",\n    \"cpu\": \"16-core, 55 W\",\n    \"ramGb\": 32,\n    \"storageGb\": 1024,\n    \"ports\": [\n      \"2x USB-C\",\n      \"3x USB-A\",\n      \"HDMI\",\n      \"Ethernet\",\n      \"SD card\"\n    ],\n    \"rating\": 4.4,\n    \"reviews\": 960,\n    \"pros\": [\n      \"Fastest of the three\",\n      \"Upgradeable RAM and SSD\",\n      \"Full port selection\"\n    ],\n    \"cons\": [\n      \"Heavy\",\n      \"Fans are audible\"\n    ],\n    \"bestFor\": \"Video editing, 3D and gaming\"\n  },\n  {\n    \"name\": \"Nimbus 13\",\n    \"tagline\": \"Everything you need, for less\",\n    \"price\": 999,\n    \"weightKg\": 1,\n    \"batteryH\": 22,\n    \"screen\": \"13\\\" IPS\",\n    \"cpu\": \"6-core, 15 W\",\n    \"ramGb\": 16,\n    \"storageGb\": 256,\n    \"ports\": [\n      \"2x USB-C\",\n      \"headphone\"\n    ],\n    \"rating\": 4.2,\n    \"reviews\": 2310,\n    \"pros\": [\n      \"Lightest\",\n      \"Best battery life\",\n      \"Lowest price\"\n    ],\n    \"cons\": [\n      \"Dimmer screen\",\n      \"Small SSD\"\n    ],\n    \"bestFor\": \"Students and light office work\"\n  }\n]","systemHash":"dcc43620444bd5561aa7a57e09f50adaace10b9cc1a0c5f2f824f41f6ed0f15b","systemOverridden":false,"strictOutput":false,"rawOutput":"<div class=\"page stack gap-lg\">\n  <header class=\"stack gap-sm\">\n    <div class=\"row between\">\n      <span class=\"badge badge-secondary\">3 laptops compared</span>\n      <span class=\"muted small\">$999–$1,899</span>\n    </div>\n    <h1 class=\"h1\">Find your right-fit laptop</h1>\n    <p class=\"lead\">Compare portability, power and price—then choose the trade-offs that work for you.</p>\n  </header>\n\n  <section class=\"card stack gap-sm\" aria-labelledby=\"picker-title\">\n    <div class=\"row between\">\n      <h2 class=\"h3\" id=\"picker-title\">What matters most to you?</h2>\n      <span class=\"muted small\">Quick recommendation</span>\n    </div>\n    <div class=\"row gap-sm\" role=\"group\" aria-label=\"Choose your priority\">\n      <button class=\"btn btn-sm\" data-pick=\"Aero 14\" aria-pressed=\"true\">Everyday balance</button>\n      <button class=\"btn btn-outline btn-sm\" data-pick=\"Forge 16\" aria-pressed=\"false\">Creative power &amp; gaming</button>\n      <button class=\"btn btn-outline btn-sm\" data-pick=\"Nimbus 13\" aria-pressed=\"false\">Budget &amp; portability</button>\n    </div>\n    <p id=\"recommendation\" aria-live=\"polite\"><strong>Aero 14 is your best fit.</strong> An OLED display, 18-hour battery and 1.2 kg weight make it a balanced choice for travel and everyday work. It costs $300 more than Nimbus 13, with twice the storage.</p>\n  </section>\n\n  <section class=\"grid cols-3 gap-lg\" aria-label=\"Laptop comparison\">\n    <article class=\"card stack gap-sm\">\n      <div><span class=\"badge\">Everyday balance</span></div>\n      <div>\n        <h2 class=\"h2\">Aero 14</h2>\n        <p class=\"muted\">Light, bright, long-lasting</p>\n      </div>\n      <div class=\"stat-value\">$1,299</div>\n      <p class=\"small\"><strong>★ 4.6 / 5</strong> <span class=\"muted\">· 1,840 reviews</span></p>\n      <div class=\"hr\"></div>\n      <div>\n        <div class=\"stat-label\">Best for</div>\n        <p><strong>Travel and everyday work</strong></p>\n      </div>\n      <dl class=\"specs\">\n        <dt>Weight</dt><dd>1.2 kg</dd>\n        <dt>Battery</dt><dd>18 hours</dd>\n        <dt>Screen</dt><dd>14&quot; OLED</dd>\n        <dt>CPU</dt><dd>8-core, 15 W</dd>\n        <dt>RAM</dt><dd>16 GB</dd>\n        <dt>Storage</dt><dd>512 GB</dd>\n        <dt>Ports</dt><dd>2x USB-C, HDMI, headphone</dd>\n      </dl>\n      <div class=\"hr\"></div>\n      <div>\n        <h3 class=\"h4 up\">Why choose it</h3>\n        <ul><li>Gorgeous OLED panel</li><li>Great battery</li><li>Quiet under load</li></ul>\n      </div>\n      <div>\n        <h3 class=\"h4\">Trade-offs</h3>\n        <ul><li>Soldered RAM</li><li>Glossy screen</li></ul>\n      </div>\n      <p class=\"small muted\">Highest rating of the three. A screen-first option without the weight of Forge 16.</p>\n    </article>\n\n    <article class=\"card stack gap-sm\">\n      <div><span class=\"badge badge-secondary\">Most performance</span></div>\n      <div>\n        <h2 class=\"h2\">Forge 16</h2>\n        <p class=\"muted\">Desktop power on the go</p>\n      </div>\n      <div class=\"stat-value\">$1,899</div>\n      <p class=\"small\"><strong>★ 4.4 / 5</strong> <span class=\"muted\">· 960 reviews</span></p>\n      <div class=\"hr\"></div>\n      <div>\n        <div class=\"stat-label\">Best for</div>\n        <p><strong>Video editing, 3D and gaming</strong></p>\n      </div>\n      <dl class=\"specs\">\n        <dt>Weight</dt><dd>2.1 kg</dd>\n        <dt>Battery</dt><dd>9 hours</dd>\n        <dt>Screen</dt><dd>16&quot; IPS 165Hz</dd>\n        <dt>CPU</dt><dd>16-core, 55 W</dd>\n        <dt>RAM</dt><dd>32 GB</dd>\n        <dt>Storage</dt><dd>1,024 GB</dd>\n        <dt>Ports</dt><dd>2x USB-C, 3x USB-A, HDMI, Ethernet, SD card</dd>\n      </dl>\n      <div class=\"hr\"></div>\n      <div>\n        <h3 class=\"h4 up\">Why choose it</h3>\n        <ul><li>Fastest of the three</li><li>Upgradeable RAM and SSD</li><li>Full port selection</li></ul>\n      </div>\n      <div>\n        <h3 class=\"h4\">Trade-offs</h3>\n        <ul><li>Heavy</li><li>Fans are audible</li></ul>\n      </div>\n      <p class=\"small muted\">$600 more than Aero 14, with double the RAM and storage—but half the battery life.</p>\n    </article>\n\n    <article class=\"card stack gap-sm\">\n      <div><span class=\"badge badge-secondary\">Lowest price · longest battery</span></div>\n      <div>\n        <h2 class=\"h2\">Nimbus 13</h2>\n        <p class=\"muted\">Everything you need, for less</p>\n      </div>\n      <div class=\"stat-value\">$999</div>\n      <p class=\"small\"><strong>★ 4.2 / 5</strong> <span class=\"muted\">· 2,310 reviews</span></p>\n      <div class=\"hr\"></div>\n      <div>\n        <div class=\"stat-label\">Best for</div>\n        <p><strong>Students and light office work</strong></p>\n      </div>\n      <dl class=\"specs\">\n        <dt>Weight</dt><dd>1 kg</dd>\n        <dt>Battery</dt><dd>22 hours</dd>\n        <dt>Screen</dt><dd>13&quot; IPS</dd>\n        <dt>CPU</dt><dd>6-core, 15 W</dd>\n        <dt>RAM</dt><dd>16 GB</dd>\n        <dt>Storage</dt><dd>256 GB</dd>\n        <dt>Ports</dt><dd>2x USB-C, headphone</dd>\n      </dl>\n      <div class=\"hr\"></div>\n      <div>\n        <h3 class=\"h4 up\">Why choose it</h3>\n        <ul><li>Lightest</li><li>Best battery life</li><li>Lowest price</li></ul>\n      </div>\n      <div>\n        <h3 class=\"h4\">Trade-offs</h3>\n        <ul><li>Dimmer screen</li><li>Small SSD</li></ul>\n      </div>\n      <p class=\"small muted\">Save $300 versus Aero 14 and get 4 more battery hours in a 0.2 kg lighter laptop.</p>\n    </article>\n  </section>\n\n  <section class=\"card stack gap-sm\" aria-labelledby=\"decision-title\">\n    <h2 class=\"h3\" id=\"decision-title\">The deciding trade-off</h2>\n    <p><strong>Pick Aero 14</strong> if you want the OLED screen and a portable everyday machine. <strong>Pick Forge 16</strong> if demanding software, gaming or upgradeability outweigh weight and battery life. <strong>Pick Nimbus 13</strong> if saving money and carrying less matter more than screen quality and storage.</p>\n    <p class=\"small muted\">Battery figures are supplied estimates; actual runtime varies with workload and settings. Ratings and review counts are shown as provided.</p>\n  </section>\n</div>\n<style>\n.specs{display:grid;grid-template-columns:5rem 1fr;gap:.7rem 1rem;margin:0}.specs dt{opacity:.65}.specs dd{margin:0;font-weight:500;overflow-wrap:anywhere}.specs dd:last-child{min-height:4.5em}article ul{padding-left:1.2rem;margin:.5rem 0}article li{margin:.35rem 0}\n</style>\n<script>\n(function(){\nconst copy={\n\"Aero 14\":\"An OLED display, 18-hour battery and 1.2 kg weight make it a balanced choice for travel and everyday work. It costs $300 more than Nimbus 13, with twice the storage.\",\n\"Forge 16\":\"Choose the fastest of the three for video editing, 3D and gaming, with 32 GB RAM, upgradeable memory and storage, and the widest port selection. Expect 2.1 kg of weight and a 9-hour battery.\",\n\"Nimbus 13\":\"At $999 and 1 kg, it is the least expensive and lightest option, with the longest battery life at 22 hours. The trade-offs are a dimmer screen and 256 GB of storage.\"\n};\n