entById('login-status');\n    status.textContent = 'Sign-in is not connected yet. Your credentials have not been sent.';\n    status.hidden = false;\n  });\n</script>","deltas":[[8022,"<"],[8028,"main"],[8029," class"],[8032,"=\""],[8032,"page"],[8032,"\">\n"],[8114," "],[8122," <"],[8181,"div"],[8181," class"],[8181,"=\""],[8181,"card"],[8181," stack"],[8181,"\""],[8236," style"],[8237,"=\""],[8352,"max"],[8357,"-width"],[8366,":"],[8370,"420"],[8374,"px"],[8378,";width"],[8379,":"],[8380,"100"],[8471,"%;"],[8482,"margin"],[8488,":"],[8490,"10"],[8588,"vh"],[8597," auto"],[8700,";padding"],[8701,":"],[8710,"32"],[8714,"px"],[8719,";"],[8721,"box"],[8721,"-sizing"],[8722,":border"],[8815,"-box"],[8821,"\">\n"],[8826,"   "],[8826," <"],[8939,"header"],[8943," class"],[8945,"=\""],[8946,"stack"],[9056," gap"],[9059,"-sm"],[9066,"\">\n"],[9070,"     "],[9073," <"],[9078,"h"],[9080,"1"],[9082," class"],[9082,"=\""],[9082,"h"],[9165,"2"],[9302,"\""],[9305," style"],[9312,"=\""],[9325,"margin"],[9330,":"],[9338,"0"],[9345,"\">"],[9349,"Welcome"],[9353," back"],[9356,"</"],[9358,"h"],[9367,"1"],[9371,">\n"],[9377,"     "],[9379," <"],[9381,"p"],[9417," class"],[9421,"=\""],[9427,"mut"],[9433,"ed"],[9442,"\""],[9445," style"],[9451,"=\""],[9458,"margin"],[9463,":"],[9466,"0"],[9470,"\">"],[9527,"Enter"],[9537," your"],[9542," email"],[9548," and"],[9562," password"],[9569," to"],[9572," sign"],[9578," in"],[9596,".</"],[9596,"p"],[9603,">\n"],[9607,"   "],[9617," </"],[9617,"header"],[9623,">\n\n"],[9623,"   "],[9649," <"],[9656,"form"],[9661," id"],[9664,"=\""],[9668,"login"],[9670,"-form"],[9673,"\""],[9675," class"],[9678,"=\""],[9682,"stack"],[9686," gap"],[9688,"-lg"],[9695,"\">\n"],[9695,"     "],[9696," <"],[9697,"label"],[9761," class"],[9769,"=\""],[9779,"label"],[9784,"\">\n"],[9790,"       "],[9794," Email"],[9800," address"],[9801,"\n"],[9801,"       "],[9802," <"],[9804,"input"],[9804," type"],[9874,"=\""],[9877,"email"],[9886,"\""],[9890," name"],[9896,"=\""],