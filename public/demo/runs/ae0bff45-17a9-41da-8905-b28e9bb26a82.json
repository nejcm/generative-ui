e\"}\">${label}</span>`;\n  }\n\n  function render() {\n    const tbody = document.getElementById(\"orders-body\");\n    const empty = document.getElementById(\"empty\");\n    const q = currentQuery.toLowerCase();\n\n    const filtered = orders.filter(o => {\n      const matchStatus = currentFilter === \"all\" || o.status === currentFilter;\n      const matchText = !q || o.customer.toLowerCase().includes(q) || o.email.toLowerCase().includes(q) || String(o.id).includes(q);\n      return matchStatus && matchText;\n    });\n\n    tbody.innerHTML = \"\";\n    filtered.forEach(o => {\n      const tr = document.createElement(\"tr\");\n      tr.innerHTML = `\n        <td><strong>#${o.id}</strong></td>\n        <td>${o.customer}</td>\n        <td><span class=\"muted\">${o.email}</span></td>\n        <td>${statusBadge(o.status)}</td>\n        <td class=\"num\">${formatCurrency(o.amount)}</td>\n        <td>${o.date}</td>\n        <td>${o.items}</td>\n        <td>${o.method}</td>\n      `;\n      tbody.appendChild(tr);\n    });\n\n    empty.style.display = filtered.length === 0 ? \"block\" : \"none\";\n\n    // Update stats\n    const total = orders.length;\n    const rev = orders.filter(o => o.status === \"paid\").reduce((s,o) => s + o.amount, 0);\n    const pending = orders.filter(o => o.status === \"pending\").length;\n\n    document.getElementById(\"stat-total\").textContent = total;\n    document.getElementById(\"stat-rev\").textContent = formatCurrency(rev);\n    document.getElementById(\"stat-pending\").textContent = pending;\n  }\n\n  function setFilter(btn, filter) {\n    currentFilter = filter;\n    document.querySelectorAll(\"#filters button\").forEach(b => {\n      b.classList.remove(\"btn-secondary\");\n      b.classList.add(\"btn-outline\");\n      b.classList.remove(\"active-filter\");\n    });\n    btn.classList.remove(\"btn-outline\");\n    btn.classList.add(\"btn-secondary\", \"active-filter\");\n    render();\n  }\n\n  document.getElementById(\"search\").add